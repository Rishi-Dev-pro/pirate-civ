<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page_title || "Edit Artifact | Pirate-Civ" %></title>

    <!-- Google Fonts: Cinzel & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Master & Dedicated Island Store Styles -->
    <link rel="stylesheet" href="/css/style.css?v=p4_edit_v1">
    <link rel="stylesheet" href="/css/island-store.css?v=p4_edit_v1">
</head>

<body class="island-store-body seller-edit-body">

    <!-- Fixed Atmospheric Backdrop -->
    <div class="store-backdrop">
        <img src="<%= (island && island.image) ? island.image : '/images/astrolabe-bg.jpg' %>"
             alt="Archipelago Backdrop"
             class="store-bg-img"
             onerror="this.onerror=null; this.src='/images/astrolabe-bg.jpg';">
        <div class="store-vignette"></div>
    </div>

    <!-- Reusable Main Navigation Bar -->
    <%- include("../partials/header") %>

    <!-- Master Stage -->
    <main class="seller-dashboard-wrapper">

        <!-- Top Navigation Bar: Breadcrumbs & Header Controls -->
        <nav class="detail-nav-bar" aria-label="Breadcrumb Navigation">
            <div class="detail-breadcrumbs">
                <a href="/home" class="crumb-link">Sea Chart</a>
                <span class="crumb-separator">›</span>
                <a href="/seller/dashboard" class="crumb-link">Command Deck</a>
                <span class="crumb-separator">›</span>
                <a href="/seller/products" class="crumb-link">Vault Products</a>
                <span class="crumb-separator">›</span>
                <span class="crumb-current">Edit: <%= product.name %></span>
            </div>

            <div class="store-header-controls">
                <div class="doubloons-pill">
                    <span class="coin-icon">🪙</span>
                    <span>Forge Deck</span>
                </div>

                <a href="/seller/products" class="btn-store-cart" style="text-decoration: none;" title="Return to Products">
                    <span>← CANCEL</span>
                </a>

                <a href="/home" class="btn-store-close" title="Return to Sea Chart">
                    &times;
                </a>
            </div>
        </nav>

        <!-- Product Edit Form Card -->
        <article class="seller-edit-form-card">

            <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px; border-bottom: 1px solid rgba(212, 147, 57, 0.25); padding-bottom: 18px;">
                <img src="<%= product.image || '/images/items/default-relic.png' %>"
                     alt="<%= product.name %>"
                     style="width: 60px; height: 60px; border-radius: 8px; border: 1px solid #d49339; object-fit: cover;"
                     onerror="this.onerror=null; this.src='/images/items/default-relic.png';">
                <div>
                    <h1 style="font-family: 'Cinzel', serif; font-size: 1.6rem; color: #fff3d4; margin: 0 0 4px 0;">
                        ✏️ Re-forge Artifact Details
                    </h1>
                    <span style="font-size: 0.85rem; color: #94a3b8;">
                        Editing: <strong style="color: #ffd57e;"><%= product.name %></strong> (slug: <%= product.slug %>)
                    </span>
                </div>
            </div>

            <!-- Error Banner -->
            <% if (error) { %>
                <div class="seller-alert-banner alert-error" role="alert" id="editErrorBanner">
                    <span>☠</span>
                    <span><%= error %></span>
                </div>
            <% } %>

            <!-- Form -->
            <form method="POST" action="/seller/products/<%= product._id %>/edit" id="formEditProduct" enctype="multipart/form-data">

                <!-- Row 1: Name -->
                <div class="seller-form-group">
                    <label for="inputName">Artifact Title *</label>
                    <input type="text"
                           id="inputName"
                           name="name"
                           class="seller-form-input"
                           maxlength="120"
                           value="<%= product.name %>"
                           required>
                </div>

                <!-- Row 2: Price & Stock -->
                <div class="seller-form-row">
                    <div class="seller-form-group">
                        <label for="inputPrice">Valuation (🪙 Doubloons) *</label>
                        <input type="number"
                               id="inputPrice"
                               name="price"
                               class="seller-form-input"
                               min="0"
                               step="1"
                               value="<%= product.price %>"
                               required>
                    </div>

                    <div class="seller-form-group">
                        <label for="inputStock">Vault Reserve Stock (Units) *</label>
                        <input type="number"
                               id="inputStock"
                               name="stock"
                               class="seller-form-input"
                               min="0"
                               step="1"
                               value="<%= product.stock %>"
                               required>
                    </div>
                </div>

                <!-- Row 3: Island & Category -->
                <div class="seller-form-row">
                    <div class="seller-form-group">
                        <label for="selectIsland">Trading Island Origin *</label>
                        <select id="selectIsland" name="island" class="seller-form-select" required>
                            <% canonicalIslands.forEach(function(isl) { %>
                                <option value="<%= isl %>" <%= product.island === isl ? 'selected' : '' %>>
                                    🏝️ <%= isl.replace('_', ' ').toUpperCase() %>
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="seller-form-group">
                        <label for="inputCategory">Trade Branch / Category *</label>
                        <input type="text"
                               id="inputCategory"
                               name="category"
                               class="seller-form-input"
                               value="<%= product.category %>"
                               required>
                    </div>
                </div>

                <!-- Row 4: Description -->
                <div class="seller-form-group">
                    <label for="inputDescription">Artifact Chronicle & Lore Description *</label>
                    <textarea id="inputDescription"
                              name="description"
                              class="seller-form-textarea"
                              maxlength="2000"
                              required><%= product.description %></textarea>
                </div>

                <!-- Row 5: Image & Rating -->
                <div class="seller-form-row">
                    <div class="seller-form-group">
                        <label for="inputImage">Image (Upload File or Asset Path)</label>
                        <input type="file"
                               id="inputFileImage"
                               name="productImage"
                               class="seller-form-input"
                               accept="image/*">
                        <input type="text"
                               id="inputImage"
                               name="image"
                               class="seller-form-input"
                               style="margin-top: 6px;"
                               value="<%= product.image %>">
                    </div>

                    <div class="seller-form-group">
                        <label for="selectRating">Masterwork Rating (1-5 Stars)</label>
                        <select id="selectRating" name="rating" class="seller-form-select">
                            <option value="5" <%= (product.rating === '★★★★★' || product.rating === '5' || product.rating === 5) ? 'selected' : '' %>>★★★★★ (5 Stars - Sovereign Masterwork)</option>
                            <option value="4" <%= (product.rating === '★★★★☆' || product.rating === '4' || product.rating === 4) ? 'selected' : '' %>>★★★★☆ (4 Stars - Exceptional Craft)</option>
                            <option value="3" <%= (product.rating === '★★★☆☆' || product.rating === '3' || product.rating === 3) ? 'selected' : '' %>>★★★☆☆ (3 Stars - Seaworthy Standard)</option>
                            <option value="2" <%= (product.rating === '★★☆☆☆' || product.rating === '2' || product.rating === 2) ? 'selected' : '' %>>★★☆☆☆ (2 Stars - Weathered Artifact)</option>
                            <option value="1" <%= (product.rating === '★☆☆☆☆' || product.rating === '1' || product.rating === 1) ? 'selected' : '' %>>★☆☆☆☆ (1 Star - Crude Salvage)</option>
                        </select>
                    </div>
                </div>

                <!-- Row 6: Availability Checkbox -->
                <div class="seller-checkbox-group">
                    <input type="checkbox"
                           id="checkAvailable"
                           name="isAvailable"
                           value="true"
                           <%= product.isAvailable ? 'checked' : '' %>>
                    <label for="checkAvailable">
                        <strong>Available in Archipelago Markets</strong> (Uncheck to hide from public storefront & island listings without deleting)
                    </label>
                </div>

                <!-- Actions -->
                <div class="seller-form-actions">
                    <a href="/seller/products" class="btn-form-cancel">
                        Discard Changes
                    </a>
                    <button type="submit" class="btn-form-submit" id="btnSubmitEdit">
                        💾 Save Artifact Changes
                    </button>
                </div>

            </form>

        </article>

    </main>

</body>

</html>
