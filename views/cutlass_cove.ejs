<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page_title || "Cutlass Cove | Rishi's Web" %></title>

    <!-- Google Fonts: Cinzel & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Base Pirate Styles & Dedicated Island Store Styles -->
    <link rel="stylesheet" href="/css/style.css?v=p3_corsair_v1">
    <link rel="stylesheet" href="/css/island-store.css?v=cutlass_v1">
</head>

<body class="island-store-body theme-cutlass">

    <!-- Fixed Atmospheric Backdrop (Cutlass Cove Corsair Citadel & Waterfalls Harbor Artwork) -->
    <div class="store-backdrop">
        <img src="/images/cutlass-bg.jpg" alt="Cutlass Cove Corsair Citadel" class="store-bg-img" style="opacity: 0.90; object-position: center 25%;">
        <div class="store-vignette" style="background: radial-gradient(circle at 75% 45%, transparent 20%, rgba(6, 12, 18, 0.55) 65%, rgba(2, 6, 10, 0.92) 100%), linear-gradient(180deg, rgba(4, 8, 12, 0.45) 0%, transparent 20%, rgba(4, 8, 12, 0.7) 85%, #040608 100%);"></div>
    </div>

    <!-- Adjusted Reusable Navbar (Non-colliding, Flow-Anchored) -->
    <%- include("partials/header") %>

    <!-- Master Store Stage -->
    <main class="island-store-wrapper">

        <!-- Top Bar: Center Title & Right Header Controls -->
        <header class="store-top-bar">
            <div class="store-header-center">
                <span class="store-badge-embargo">WEAPONRY</span>
                <h1 class="store-main-title">
                    <span class="store-title-icon">🧭</span>
                    <span><%= island.name %></span>
                </h1>
                <div class="store-subheading"><%= island.title || "ELECTRONICS" %></div>
                <p class="store-subtitle"><%= island.desc || "Innovative tools for modern explorers. Power your journey." %></p>
            </div>

            <div class="store-header-controls">
                <div class="doubloons-pill">
                    <span class="coin-icon">🪙</span>
                    <span>1,240 Doubloons</span>
                </div>

                <button id="btnOpenCart" class="btn-store-cart">
                    <span>🛒 CART</span>
                    <span id="cartCountBadge">(0)</span>
                </button>

                <a href="/?branch=apparel#sea-chart-section" class="btn-store-close" title="Return to Sea Chart">
                    &times;
                </a>
            </div>
        </header>

        <!-- Body Grid: Sidebar + Store Grid Area -->
        <div class="store-body-grid">

            <!-- Left Sidebar Category Filter (Matches Reference Image) -->
            <aside class="store-sidebar">
                <ul class="sidebar-nav-list">
                    <li class="sidebar-nav-item active" data-category="all">
                        <span class="nav-icon">✦</span>
                        <span>All Items</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="smart">
                        <span class="nav-icon">📱</span>
                        <span>Smart Devices</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="audio">
                        <span class="nav-icon">🎧</span>
                        <span>Audio & Sound</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="computing">
                        <span class="nav-icon">💻</span>
                        <span>Computing</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="gaming">
                        <span class="nav-icon">🎮</span>
                        <span>Gaming Gear</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="cameras">
                        <span class="nav-icon">📷</span>
                        <span>Cameras</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="accessories">
                        <span class="nav-icon">🔌</span>
                        <span>Accessories</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="power">
                        <span class="nav-icon">🔋</span>
                        <span>Power & Charging</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="drones">
                        <span class="nav-icon">🛸</span>
                        <span>Drones & Gadgets</span>
                    </li>
                </ul>

                <!-- Carved Motto Crest (Matches Reference Image) -->
                <div class="sidebar-cutlass-crest">
                    <span class="cutlass-crest-icon">🧭</span>
                    <div class="cutlass-motto-lines">
                        <span>TECHNOLOGY</span>
                        <span>FUELS</span>
                        <span>NEW HORIZONS</span>
                    </div>
                </div>
            </aside>

            <!-- Main Store Area -->
            <section class="store-main-area">

                <!-- Search & Sort Bar -->
                <div class="store-filter-bar">
                    <div class="search-input-wrapper">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="storeSearchInput" class="store-search-input" placeholder="Search electronics, gadgets, accessories...">
                    </div>

                    <select id="storeSortSelect" class="store-sort-select">
                        <option value="default">Sort by: Default ▾</option>
                        <option value="price-low">Price: Low to High</option>
                        <option value="price-high">Price: High to Low</option>
                        <option value="name">Name: A-Z</option>
                    </select>
                </div>

                <!-- Store Items Grid (6 Cards in 2 Rows of 3) -->
                <div id="storeItemsGrid" class="store-items-grid">
                    <% if (island.products && island.products.length > 0) { %>
                        <% island.products.forEach(function(p) { %>
                            <article class="store-item-card"
                                     data-id="<%= p.id %>"
                                     data-name="<%= p.name %>"
                                     data-price="<%= p.price %>"
                                     data-category="<%= p.category || 'all' %>"
                                     data-desc="<%= p.desc %>">
                                
                                <div class="card-header-bar">
                                    <span class="tag-new">NEW</span>
                                    <button class="btn-wishlist" data-id="<%= p.id %>" data-name="<%= p.name %>" title="Add to Wishlist">♡</button>
                                </div>

                                <div class="item-asset-box">
                                    <div class="item-asset-glow"></div>
                                    <img src="<%= p.image %>" alt="<%= p.name %>" class="item-asset-img">
                                </div>

                                <h3 class="item-title"><%= p.name %></h3>
                                <p class="item-desc"><%= p.desc %></p>

                                <div class="item-meta-row">
                                    <span class="item-price">🪙 <%= p.price %> Doubloons</span>
                                    <span class="item-rating"><%= p.rating || '★★★★★' %></span>
                                </div>

                                <button class="btn-add-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>">
                                    <span>🛒 ADD TO CART</span>
                                </button>
                            </article>
                        <% }); %>
                    <% } else { %>
                        <div class="store-empty-state">
                            <span class="store-empty-icon">⚓</span>
                            <h3 class="store-empty-title">No Trade Cargo Available</h3>
                            <p class="store-empty-desc">The merchant vaults of <%= island.name %> are currently barren. No goods are chartered for trading at this hour.</p>
                        </div>
                    <% } %>
                </div>

            </section>

        </div>

    </main>

    <!-- Cargo Cart Drawer -->
    <aside id="storeCartDrawer" class="store-cart-drawer">
        <div class="cart-drawer-header">
            <h3 class="cart-drawer-title">⚓ Cargo Hold</h3>
            <button id="btnCloseCart" class="btn-cart-close">&times;</button>
        </div>
        <div id="cartDrawerItems" class="cart-drawer-items"></div>
        <div class="cart-drawer-footer">
            <div class="cart-total-row">
                <span>Total Cargo:</span>
                <span id="cartDrawerTotal">🪙 0 Doubloons</span>
            </div>
            <button id="btnCheckoutCargo" class="btn-checkout-cargo">
                Secure Cargo (Checkout)
            </button>
        </div>
    </aside>

    <!-- Unified Island Store JS Engine -->
    <script src="/js/island-store.js?v=cutlass_v1"></script>

</body>

</html>
