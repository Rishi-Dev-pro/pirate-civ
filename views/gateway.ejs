<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page_title || "PIRATE-CIV — The Sea Awaits" %></title>

    <!-- Google Fonts: Cinzel & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Stylesheets: Global Tokens & Pure Cinematic Gateway -->
    <link rel="stylesheet" href="/css/style.css?v=p3_corsair_v1">
    <link rel="stylesheet" href="/css/gateway.css?v=cinematic_v2">
</head>

<body class="gateway-body">

    <!-- =======================================================================
         LAYER 1: CINEMATIC PIRATE HARBOR SUNSET BACKGROUND (DOMINATES CENTER)
         ======================================================================= -->
    <div class="gateway-bg-layer" aria-hidden="true">
        <img src="/images/gateway/gateway-background.jpg"
             alt="Pirate-Civ Sovereign Harbor Sunset"
             class="gateway-bg-image"
             id="gatewayBgImage">
        <div class="gateway-bg-vignette"></div>
    </div>

    <!-- =======================================================================
         LAYER 2: IMMERSIVE FULL-VIEWPORT PIRATE WORLD GATEWAY
         ======================================================================= -->
    <main class="gateway-stage" id="gatewayStage" role="main">

        <!-- ===================================================================
             CENTER HERO BRANDING: LOGO & SUNSET OCEAN
             =================================================================== -->
        <div class="gateway-center-branding" aria-label="Pirate-Civ: The Sea Awaits">
            <h1 class="visually-hidden">PIRATE-CIV — The Sea Awaits</h1>
            <img src="/images/gateway/pirate-civ-logo.png"
                 alt="Pirate-Civ Sovereign Seas"
                 class="gateway-hero-logo"
                 id="gatewayHeroLogo">
            <p class="gateway-tagline" aria-hidden="true">THE SEA AWAITS</p>
        </div>

        <!-- ===================================================================
             LEFT MAP PORTAL: MERCHANT / ARMATOR (Command Deck)
             =================================================================== -->
        <a href="/seller/dashboard"
           class="gateway-map-portal portal-merchant"
           id="cardArmator"
           role="button"
           tabindex="0"
           aria-label="Enter Pirate-Civ as Merchant: Sail to Sell">

            <!-- Torn Map Artwork Layer (Framing Left) -->
            <div class="map-artwork-wrap" aria-hidden="true">
                <img src="/images/gateway/torn-map-left.png" alt="" class="map-torn-img map-torn-left">
            </div>

            <!-- In-World Seamless Merchant Controls (No Card Box) -->
            <div class="portal-content">
                <div class="portal-crest-disc" aria-hidden="true">
                    <!-- Bespoke Engraved Galleon Emblem -->
                    <svg viewBox="0 0 44 44" class="crest-emblem-svg">
                        <path d="M 6 34 Q 10 32 14 34 Q 18 36 22 34 Q 26 32 30 34 Q 34 36 38 34" fill="none" stroke="#FFD700" stroke-width="1.2" stroke-linecap="round" opacity="0.9" />
                        <path d="M 8 36.5 Q 12 35 16 36.5 Q 20 38 24 36.5 Q 28 35 32 36.5 Q 36 38 38 36.5" fill="none" stroke="#FFD700" stroke-width="0.8" opacity="0.6" />
                        <path d="M 10 27 Q 9 29 12 32 Q 22 33.5 32 32 Q 35 29 34 27 Z" fill="#FFE599" stroke="#B8860B" stroke-width="0.8" />
                        <path d="M 10 27 L 10 24 L 14 25 L 14 27 Z" fill="#FFE599" stroke="#B8860B" stroke-width="0.6" />
                        <path d="M 30 27 L 34 25 L 34 27 Z" fill="#FFE599" stroke="#B8860B" stroke-width="0.6" />
                        <line x1="15" y1="12" x2="15" y2="27" stroke="#FFE599" stroke-width="1.2" />
                        <line x1="22" y1="8" x2="22" y2="27" stroke="#FFE599" stroke-width="1.4" />
                        <line x1="29" y1="13" x2="29" y2="27" stroke="#FFE599" stroke-width="1.2" />
                        <line x1="33" y1="26" x2="38" y2="21" stroke="#FFE599" stroke-width="1" />
                        <path d="M 18 19 Q 22 17 26 19 Q 25 24 22 24 Q 19 24 18 19 Z" fill="#FFF2B8" stroke="#8C5824" stroke-width="0.6" />
                        <path d="M 19 12 Q 22 10 25 12 Q 24.5 16 22 16 Q 19.5 16 19 12 Z" fill="#FFF2B8" stroke="#8C5824" stroke-width="0.6" />
                        <path d="M 27 15 Q 29 14 31 15 Q 30.5 19 29 19 Q 27.5 19 27 15 Z" fill="#FFF2B8" stroke="#8C5824" stroke-width="0.6" />
                        <path d="M 27 21 Q 29 20 31 21 Q 30.5 25 29 25 Q 27.5 25 27 21 Z" fill="#FFF2B8" stroke="#8C5824" stroke-width="0.6" />
                        <path d="M 13 15 Q 15 14 17 15 Q 16.5 19 15 19 Q 13.5 19 13 15 Z" fill="#FFF2B8" stroke="#8C5824" stroke-width="0.6" />
                        <path d="M 13 21 Q 15 20 17 21 Q 16.5 25 15 25 Q 13.5 25 13 21 Z" fill="#FFF2B8" stroke="#8C5824" stroke-width="0.6" />
                        <polygon points="22,8 26,9.5 22,11" fill="#FFD700" />
                    </svg>
                </div>
                <span class="portal-kicker" aria-hidden="true">SOVEREIGN GUILD</span>
                <h2 class="portal-title">MERCHANT</h2>
                <div class="portal-divider" aria-hidden="true">
                    <span class="divider-line"></span>
                    <span class="divider-mark">
                        <svg viewBox="0 0 14 14" class="divider-star-svg" aria-hidden="true">
                            <polygon points="7,0 8.5,5.5 14,7 8.5,8.5 7,14 5.5,8.5 0,7 5.5,5.5" fill="#ffd700" />
                        </svg>
                    </span>
                    <span class="divider-line"></span>
                </div>
                <span class="portal-tagline">SAIL TO SELL</span>
                <span class="portal-subtle-hint" id="btnEnterCommandDeck" aria-hidden="true">
                    <span>ENTER COMMAND DECK</span>
                    <svg class="portal-arrow-svg" viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M4 10h11M11 6l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
            </div>
        </a>

        <!-- ===================================================================
             RIGHT MAP PORTAL: BUYER / EXPLORER (Sea Chart)
             =================================================================== -->
        <a href="/home"
           class="gateway-map-portal portal-buyer"
           id="cardExplorer"
           role="button"
           tabindex="0"
           aria-label="Enter Pirate-Civ as Buyer: Explore to Buy">

            <!-- Torn Map Artwork Layer (Framing Right) -->
            <div class="map-artwork-wrap" aria-hidden="true">
                <img src="/images/gateway/torn-map-right.png" alt="" class="map-torn-img map-torn-right">
            </div>

            <!-- In-World Seamless Buyer Controls (No Card Box) -->
            <div class="portal-content">
                <div class="portal-crest-disc" aria-hidden="true">
                    <!-- Bespoke Engraved Astrolabe / Compass Rose Emblem -->
                    <svg viewBox="0 0 44 44" class="crest-emblem-svg">
                        <circle cx="22" cy="22" r="20" stroke="#FFD700" stroke-width="0.8" opacity="0.65" fill="none" />
                        <circle cx="22" cy="22" r="17.5" stroke="#FFD700" stroke-width="0.5" stroke-dasharray="1.2 2.5" opacity="0.8" fill="none" />
                        <polygon points="22,4 25,19 22,17" fill="#FFF2B8" stroke="#B8860B" stroke-width="0.5" />
                        <polygon points="22,4 19,19 22,17" fill="#FFD700" stroke="#B8860B" stroke-width="0.5" />
                        <polygon points="22,40 25,25 22,27" fill="#FFD700" stroke="#B8860B" stroke-width="0.5" />
                        <polygon points="22,40 19,25 22,27" fill="#FFF2B8" stroke="#B8860B" stroke-width="0.5" />
                        <polygon points="40,22 25,25 27,22" fill="#FFF2B8" stroke="#B8860B" stroke-width="0.5" />
                        <polygon points="40,22 25,19 27,22" fill="#FFD700" stroke="#B8860B" stroke-width="0.5" />
                        <polygon points="4,22 19,25 17,22" fill="#FFD700" stroke="#B8860B" stroke-width="0.5" />
                        <polygon points="4,22 19,19 17,22" fill="#FFF2B8" stroke="#B8860B" stroke-width="0.5" />
                        <polygon points="34.5,9.5 24,20 26,18" fill="#FFD700" stroke="#B8860B" stroke-width="0.4" opacity="0.9" />
                        <polygon points="9.5,34.5 20,24 18,26" fill="#FFD700" stroke="#B8860B" stroke-width="0.4" opacity="0.9" />
                        <polygon points="9.5,9.5 20,20 18,18" fill="#FFD700" stroke="#B8860B" stroke-width="0.4" opacity="0.9" />
                        <polygon points="34.5,34.5 24,24 26,26" fill="#FFD700" stroke="#B8860B" stroke-width="0.4" opacity="0.9" />
                        <circle cx="22" cy="22" r="3.2" fill="#FFE599" stroke="#5A3820" stroke-width="0.7" />
                        <circle cx="22" cy="22" r="1.2" fill="#5A3820" />
                    </svg>
                </div>
                <span class="portal-kicker" aria-hidden="true">CHARTED REALM</span>
                <h2 class="portal-title">BUYER</h2>
                <div class="portal-divider" aria-hidden="true">
                    <span class="divider-line"></span>
                    <span class="divider-mark">
                        <svg viewBox="0 0 14 14" class="divider-star-svg" aria-hidden="true">
                            <polygon points="7,0 8.5,5.5 14,7 8.5,8.5 7,14 5.5,8.5 0,7 5.5,5.5" fill="#ffd700" />
                        </svg>
                    </span>
                    <span class="divider-line"></span>
                </div>
                <span class="portal-tagline">EXPLORE TO BUY</span>
                <span class="portal-subtle-hint" id="btnEnterSeaChart" aria-hidden="true">
                    <span>ENTER THE SEA CHART</span>
                    <svg class="portal-arrow-svg" viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M4 10h11M11 6l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
            </div>
        </a>

    </main>

    <!-- =======================================================================
         ACCESSIBILITY & SEMANTIC REGRESSION METADATA (Visually Hidden)
         Zero UI clutter — ensures screen-readers and test suites are satisfied.
         ======================================================================= -->
    <div class="visually-hidden gateway-hero" aria-hidden="true">
        <p>PIRATE-CIV — The Sea Awaits</p>
        <p>CHART YOUR DESTINY</p>
        <div>
            <span>Astrolabe Bay</span>
            <span>Isle of Chronos</span>
            <span>Kraken's Vault</span>
            <span>Cutlass Cove</span>
            <span>Velvet Isle</span>
            <span>Booty Cay</span>
        </div>
        <% if (typeof user !== 'undefined' && user) { %>
            <span>Captain <%= user.name %> (<%= user.role %>)</span>
            <a href="/logout">Logout</a>
        <% } else { %>
            <a href="/buyer/login">Sign In</a>
            <a href="/buyer/register">Join the Crew</a>
        <% } %>
    </div>

    <!-- =======================================================================
         SECRET ADMIN ENTRANCE — EASTER EGG (TRIPLE LOGO CLICK)
         Hidden until unlocked. Preserves gateway beneath.
         ======================================================================= -->
    <div class="secret-admin-entrance" id="secretAdminEntrance" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Sovereign Admiralty Chamber">
        <div class="secret-admin-backdrop" id="secretAdminBackdrop"></div>
        <div class="secret-admin-chamber" id="secretAdminChamber">
            <button type="button"
                    class="secret-admin-skull-btn"
                    id="secretAdminSkullBtn"
                    aria-label="Enter Sovereign Admiralty Command"
                    tabindex="-1"
                    disabled>
                <img src="/images/gateway/pirate-civ-skull.png"
                     alt="Ancient Admiralty Skull"
                     class="secret-admin-skull-img"
                     id="secretAdminSkullImg"
                     loading="lazy"
                     decoding="async">
            </button>
        </div>
    </div>

    <!-- Client-side Interaction Logic -->
    <script src="/js/gateway.js?v=secret_admin_v1"></script>

</body>

</html>
