<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page_title || "PIRATE-CIV — The Sea Awaits" %></title>

    <!-- Google Fonts: Cinzel & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Master CSS -->
    <link rel="stylesheet" href="/css/style.css?v=p3_corsair_v1">

    <style>
        :root {
            --gw-gold: #c69f58;
            --gw-gold-bright: #ffd700;
            --gw-gold-glow: rgba(198, 159, 88, 0.4);
            --gw-cyan: #4facfe;
            --gw-cyan-glow: rgba(79, 172, 254, 0.35);
            --gw-card-bg: rgba(14, 20, 28, 0.88);
            --gw-card-border: rgba(198, 159, 88, 0.3);
            --gw-text-muted: #8b9bb4;
        }

        body.gateway-body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background-color: #080b10;
            color: #f5eedc;
            font-family: "Inter", sans-serif;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        /* Nautical Atmospheric Backdrop */
        .gateway-backdrop {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 1;
            overflow: hidden;
        }

        .gateway-bg-grid {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.22;
            filter: contrast(115%) brightness(80%);
        }

        .gateway-vignette {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 50% 45%, rgba(8, 11, 16, 0.4) 0%, rgba(8, 11, 16, 0.92) 80%, #080b10 100%);
        }

        /* Minimal Branded Header */
        .gateway-header {
            position: relative;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 32px;
            border-bottom: 1px solid rgba(198, 159, 88, 0.2);
            background: rgba(8, 11, 16, 0.7);
            backdrop-filter: blur(8px);
        }

        .gateway-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #ffd700;
        }

        .gateway-brand-icon {
            font-size: 1.6rem;
            filter: drop-shadow(0 0 8px rgba(255, 215, 0, 0.5));
        }

        .gateway-brand-text {
            font-family: "Cinzel", serif;
            font-size: 1.25rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            color: #ffd700;
        }

        .gateway-top-nav {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .gateway-top-link {
            font-family: "Cinzel", serif;
            font-size: 0.85rem;
            color: #c69f58;
            text-decoration: none;
            letter-spacing: 0.05em;
            padding: 6px 12px;
            border-radius: 4px;
            transition: all 0.2s ease;
        }

        .gateway-top-link:hover,
        .gateway-top-link:focus-visible {
            color: #ffd700;
            background: rgba(198, 159, 88, 0.15);
            outline: none;
        }

        .gateway-top-btn {
            font-family: "Cinzel", serif;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            color: #080b10;
            background: linear-gradient(135deg, #e5be75 0%, #c69f58 100%);
            padding: 8px 18px;
            border-radius: 4px;
            text-decoration: none;
            transition: all 0.25s ease;
            box-shadow: 0 2px 10px rgba(198, 159, 88, 0.3);
        }

        .gateway-top-btn:hover,
        .gateway-top-btn:focus-visible {
            background: linear-gradient(135deg, #ffd700 0%, #e5be75 100%);
            box-shadow: 0 4px 16px rgba(255, 215, 0, 0.5);
            transform: translateY(-1px);
            outline: none;
        }

        .gateway-user-tag {
            font-family: "Inter", sans-serif;
            font-size: 0.85rem;
            color: #bbf7d0;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* Master Content Container */
        .gateway-content {
            position: relative;
            z-index: 5;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 24px 60px 24px;
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            box-sizing: border-box;
        }

        /* Hero Header Section */
        .gateway-hero {
            text-align: center;
            margin-bottom: 36px;
            max-width: 780px;
        }

        .gateway-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: "Cinzel", serif;
            font-size: 0.78rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--gw-gold);
            padding: 4px 14px;
            border: 1px solid rgba(198, 159, 88, 0.35);
            border-radius: 20px;
            background: rgba(14, 20, 28, 0.6);
            margin-bottom: 14px;
        }

        .gateway-hero-title {
            font-family: "Cinzel", serif;
            font-size: clamp(2.4rem, 6vw, 3.8rem);
            font-weight: 800;
            letter-spacing: 0.1em;
            margin: 0 0 6px 0;
            background: linear-gradient(180deg, #ffffff 0%, #ffd700 60%, #b8860b 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 4px 18px rgba(212, 147, 57, 0.45));
            text-transform: uppercase;
        }

        .gateway-hero-sub {
            font-family: "Cinzel", serif;
            font-size: clamp(1.1rem, 2.5vw, 1.45rem);
            font-weight: 600;
            color: #f5eedc;
            letter-spacing: 0.08em;
            margin: 0 0 12px 0;
        }

        .gateway-hero-desc {
            font-size: clamp(0.9rem, 1.8vw, 1.02rem);
            color: var(--gw-text-muted);
            line-height: 1.55;
            margin: 0 auto 20px auto;
            max-width: 620px;
        }

        /* Decorative Archipelago Constellation Chips */
        .gateway-islands-bar {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 34px;
        }

        .island-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: "Cinzel", serif;
            font-size: 0.72rem;
            letter-spacing: 0.04em;
            color: #c69f58;
            background: rgba(10, 15, 20, 0.65);
            border: 1px solid rgba(198, 159, 88, 0.22);
            border-radius: 14px;
            padding: 4px 12px;
            transition: all 0.2s ease;
        }

        .island-chip:hover {
            color: #ffd700;
            border-color: rgba(198, 159, 88, 0.6);
            transform: translateY(-1px);
        }

        /* The Dual Fork Choice Container */
        .gateway-fork-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(320px, 460px));
            gap: 32px;
            width: 100%;
            justify-content: center;
            margin-bottom: 40px;
        }

        /* Gateway Choice Card */
        .gateway-card {
            background: var(--gw-card-bg);
            border: 1px solid var(--gw-card-border);
            border-radius: 12px;
            padding: 36px 30px 30px 30px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(10px);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                        border-color 0.3s ease,
                        box-shadow 0.3s ease;
            overflow: hidden;
        }

        .gateway-card::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 12px;
            padding: 1px;
            background: linear-gradient(145deg, rgba(198, 159, 88, 0.4) 0%, transparent 60%);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
        }

        /* Card Hover States */
        .gateway-card-explorer:hover,
        .gateway-card-explorer:focus-within {
            transform: translateY(-5px);
            border-color: rgba(79, 172, 254, 0.6);
            box-shadow: 0 18px 45px rgba(0, 0, 0, 0.75), 0 0 30px var(--gw-cyan-glow);
        }

        .gateway-card-merchant:hover,
        .gateway-card-merchant:focus-within {
            transform: translateY(-5px);
            border-color: rgba(255, 215, 0, 0.7);
            box-shadow: 0 18px 45px rgba(0, 0, 0, 0.75), 0 0 30px var(--gw-gold-glow);
        }

        .card-emblem-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 72px;
            height: 72px;
            border-radius: 50%;
            margin: 0 auto 20px auto;
            position: relative;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .gateway-card-explorer .card-emblem-wrap {
            background: radial-gradient(circle, rgba(79, 172, 254, 0.2) 0%, rgba(10, 15, 24, 0.9) 70%);
            border: 2px solid rgba(79, 172, 254, 0.5);
            box-shadow: 0 0 16px rgba(79, 172, 254, 0.3);
        }

        .gateway-card-merchant .card-emblem-wrap {
            background: radial-gradient(circle, rgba(255, 215, 0, 0.2) 0%, rgba(20, 15, 10, 0.9) 70%);
            border: 2px solid rgba(255, 215, 0, 0.5);
            box-shadow: 0 0 16px rgba(255, 215, 0, 0.3);
        }

        .gateway-card:hover .card-emblem-wrap {
            transform: scale(1.08);
        }

        .card-emblem-icon {
            font-size: 2.2rem;
            filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.8));
        }

        .card-tag {
            font-family: "Cinzel", serif;
            font-size: 0.72rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            text-align: center;
            margin-bottom: 6px;
        }

        .gateway-card-explorer .card-tag {
            color: #68c0ff;
        }

        .gateway-card-merchant .card-tag {
            color: #ffd700;
        }

        .card-title {
            font-family: "Cinzel", serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: 0.04em;
            text-align: center;
            margin: 0 0 10px 0;
        }

        .card-pitch {
            font-style: italic;
            font-size: 0.94rem;
            color: #fff4db;
            text-align: center;
            line-height: 1.45;
            margin: 0 0 20px 0;
            padding-bottom: 18px;
            border-bottom: 1px solid rgba(198, 159, 88, 0.18);
        }

        .card-perks-list {
            list-style: none;
            padding: 0;
            margin: 0 0 26px 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .card-perk-item {
            font-size: 0.88rem;
            color: #cbd5e1;
            display: flex;
            align-items: center;
            gap: 10px;
            line-height: 1.35;
        }

        .perk-bullet {
            color: #ffd700;
            font-size: 1rem;
            flex-shrink: 0;
        }

        /* Primary Action Buttons */
        .btn-gateway-cta {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 14px 24px;
            font-family: "Cinzel", serif;
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            text-decoration: none;
            border-radius: 6px;
            transition: all 0.25s ease;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5);
            position: relative;
            overflow: hidden;
        }

        .btn-gateway-explorer {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: #080b10;
            border: 1px solid #5cf59b;
        }

        .btn-gateway-explorer:hover,
        .btn-gateway-explorer:focus-visible {
            background: linear-gradient(135deg, #18b3a7 0%, #4ffd90 100%);
            box-shadow: 0 8px 25px rgba(56, 239, 125, 0.45);
            transform: translateY(-2px);
            color: #080b10;
            outline: none;
        }

        .btn-gateway-merchant {
            background: linear-gradient(135deg, #d49339 0%, #a46c1b 100%);
            color: #080b10;
            border: 1px solid #ffd57e;
        }

        .btn-gateway-merchant:hover,
        .btn-gateway-merchant:focus-visible {
            background: linear-gradient(135deg, #f0ac46 0%, #ba7b20 100%);
            box-shadow: 0 8px 25px rgba(212, 147, 57, 0.5);
            transform: translateY(-2px);
            color: #080b10;
            outline: none;
        }

        .btn-arrow {
            font-size: 1.15rem;
            transition: transform 0.25s ease;
        }

        .btn-gateway-cta:hover .btn-arrow {
            transform: translateX(4px);
        }

        /* Bottom Anchor Lore */
        .gateway-bottom-lore {
            text-align: center;
            max-width: 600px;
            margin-top: 10px;
        }

        .destiny-title {
            font-family: "Cinzel", serif;
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 0.15em;
            color: #ffd700;
            text-transform: uppercase;
            margin: 0 0 6px 0;
        }

        .destiny-desc {
            font-size: 0.8rem;
            color: var(--gw-text-muted);
            margin: 0 0 16px 0;
            letter-spacing: 0.04em;
        }

        .gateway-auth-hint {
            font-size: 0.85rem;
            color: #bbf7d0;
            padding: 10px 18px;
            background: rgba(14, 20, 28, 0.7);
            border: 1px solid rgba(198, 159, 88, 0.25);
            border-radius: 20px;
            display: inline-block;
        }

        .gateway-auth-hint a {
            color: #ffd700;
            text-decoration: underline;
            text-underline-offset: 3px;
            font-weight: 600;
        }

        .gateway-auth-hint a:hover,
        .gateway-auth-hint a:focus-visible {
            color: #ffffff;
            outline: none;
        }

        /* Responsive Breakpoints */
        @media (max-width: 820px) {
            .gateway-fork-grid {
                grid-template-columns: 1fr;
                max-width: 480px;
                gap: 24px;
            }

            .gateway-header {
                padding: 14px 20px;
            }

            .gateway-card {
                padding: 28px 22px 24px 22px;
            }
        }
    </style>
</head>

<body class="gateway-body">

    <!-- Atmospheric Map Backdrop -->
    <div class="gateway-backdrop" aria-hidden="true">
        <img src="/images/nautical-grid.png" alt="" class="gateway-bg-grid">
        <div class="gateway-vignette"></div>
    </div>

    <!-- Minimal Branded Navigation Bar -->
    <header class="gateway-header" role="banner">
        <a href="/" class="gateway-brand" title="Pirate-Civ Sovereign Gateway">
            <span class="gateway-brand-icon" aria-hidden="true">🏴‍☠️</span>
            <span class="gateway-brand-text">PIRATE-CIV</span>
        </a>

        <nav class="gateway-top-nav" aria-label="Gateway Navigation">
            <a href="/about" class="gateway-top-link">Guild Lore</a>

            <% if (typeof user !== 'undefined' && user) { %>
                <span class="gateway-user-tag">
                    <span>⚓</span>
                    <strong><%= user.name %></strong>
                    <span style="font-size:0.75rem; color:#8b9bb4;">(<%= user.role %>)</span>
                </span>
                <% if (user.role === 'buyer') { %>
                    <a href="/orders" class="gateway-top-link" id="topNavVoyages">My Voyages</a>
                <% } else if (user.role === 'seller') { %>
                    <a href="/seller/dashboard" class="gateway-top-link" id="topNavCommand">Command Deck</a>
                <% } %>
                <a href="/logout" class="gateway-top-btn" id="topNavLogout">Logout</a>
            <% } else { %>
                <a href="/login" class="gateway-top-link" id="linkSignIn">Sign In</a>
                <a href="/register" class="gateway-top-btn" id="linkRegister">Join the Crew</a>
            <% } %>
        </nav>
    </header>

    <!-- Master Gateway Content -->
    <main class="gateway-content">

        <!-- Hero Section -->
        <section class="gateway-hero" aria-labelledby="gatewayMainTitle">
            <div class="gateway-eyebrow">
                <span>🧭</span> High Seas Commerce &bull; Anno 1692
            </div>
            <h1 class="gateway-hero-title" id="gatewayMainTitle">PIRATE-CIV</h1>
            <p class="gateway-hero-sub">The Sea Awaits.</p>
            <p class="gateway-hero-desc">
                Six chartered islands. Untold treasures. Sovereign merchant vaults.
                Choose your charter to explore the archipelago or take command of the high seas trade.
            </p>

            <!-- 6 Islands Constellation Legend -->
            <div class="gateway-islands-bar" aria-label="Chartered Islands of the Archipelago">
                <span class="island-chip">🧭 Astrolabe Bay</span>
                <span class="island-chip">⏳ Isle of Chronos</span>
                <span class="island-chip">🐙 Kraken's Vault</span>
                <span class="island-chip">⚔️ Cutlass Cove</span>
                <span class="island-chip">🧣 Velvet Isle</span>
                <span class="island-chip">💀 Booty Cay</span>
            </div>
        </section>

        <!-- Dual Gateway Fork Grid -->
        <section class="gateway-fork-grid" aria-label="Gateway Portals">

            <!-- Card 1: Customer / Explorer -->
            <article class="gateway-card gateway-card-explorer" id="cardExplorer">
                <div>
                    <div class="card-emblem-wrap">
                        <span class="card-emblem-icon" aria-hidden="true">🏴‍☠️</span>
                    </div>

                    <div class="card-tag">Archipelago Explorer</div>
                    <h2 class="card-title">Customer / Explorer</h2>
                    <p class="card-pitch">
                        "Chart the islands. Discover rare cargo. Fill your hold."
                    </p>

                    <ul class="card-perks-list" aria-label="Explorer Features">
                        <li class="card-perk-item">
                            <span class="perk-bullet" aria-hidden="true">🗺️</span>
                            <span>Chart 6 legendary trading island bazaars</span>
                        </li>
                        <li class="card-perk-item">
                            <span class="perk-bullet" aria-hidden="true">📦</span>
                            <span>Stow ancient relics, weapons & provisions</span>
                        </li>
                        <li class="card-perk-item">
                            <span class="perk-bullet" aria-hidden="true">🪙</span>
                            <span>Transact in native Doubloons currency</span>
                        </li>
                        <li class="card-perk-item">
                            <span class="perk-bullet" aria-hidden="true">📜</span>
                            <span>Track fleet voyage manifests to your harbor</span>
                        </li>
                    </ul>
                </div>

                <a href="/home" class="btn-gateway-cta btn-gateway-explorer" id="btnEnterSeaChart" role="button">
                    <span>Enter the Sea Chart</span>
                    <span class="btn-arrow" aria-hidden="true">&rarr;</span>
                </a>
            </article>

            <!-- Card 2: Merchant / Armator -->
            <article class="gateway-card gateway-card-merchant" id="cardArmator">
                <div>
                    <div class="card-emblem-wrap">
                        <span class="card-emblem-icon" aria-hidden="true">⚓</span>
                    </div>

                    <div class="card-tag">Archipelago Merchant</div>
                    <h2 class="card-title">Merchant / Armator</h2>
                    <p class="card-pitch">
                        "Command your storefront. Forge cargo. Dispatch your wares."
                    </p>

                    <ul class="card-perks-list" aria-label="Merchant Features">
                        <li class="card-perk-item">
                            <span class="perk-bullet" aria-hidden="true">📜</span>
                            <span>Command Deck with real-time catalog telemetry</span>
                        </li>
                        <li class="card-perk-item">
                            <span class="perk-bullet" aria-hidden="true">⚒️</span>
                            <span>Forge new cargo wares & manage vault reserves</span>
                        </li>
                        <li class="card-perk-item">
                            <span class="perk-bullet" aria-hidden="true">🚢</span>
                            <span>Fulfill orders & advance dispatch manifests</span>
                        </li>
                        <li class="card-perk-item">
                            <span class="perk-bullet" aria-hidden="true">🏝️</span>
                            <span>Sovereign storefront affiliated with your harbor</span>
                        </li>
                    </ul>
                </div>

                <a href="/seller/dashboard" class="btn-gateway-cta btn-gateway-merchant" id="btnEnterCommandDeck" role="button">
                    <span>Enter the Command Deck</span>
                    <span class="btn-arrow" aria-hidden="true">&rarr;</span>
                </a>
            </article>

        </section>

        <!-- Bottom Anchor Lore & Authentication Hints -->
        <footer class="gateway-bottom-lore">
            <h3 class="destiny-title">CHART YOUR DESTINY</h3>
            <p class="destiny-desc">
                Sovereign trade across the Archipelago Trade Guilds &bull; Anno 1692
            </p>

            <% if (typeof user !== 'undefined' && user) { %>
                <div class="gateway-auth-hint">
                    Logged in as <strong><%= user.name %></strong> (<%= user.role %>) &bull;
                    <a href="/logout">Disembark (Logout)</a>
                </div>
            <% } else { %>
                <div class="gateway-auth-hint">
                    Already a Captain? <a href="/login" id="linkBottomSignIn">Sign In</a> &bull;
                    New to Pirate-Civ? <a href="/register" id="linkBottomRegister">Join the Crew</a>
                </div>
            <% } %>
        </footer>

    </main>

</body>

</html>
