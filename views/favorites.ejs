<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page_title || "Captain's Favorites | Pirate-Civ" %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css?v=p3_corsair_v1">
    <link rel="stylesheet" href="/css/island-store.css?v=detail_v1">
    <link rel="stylesheet" href="/css/favorites.css?v=fav_v1">
</head>
<body class="island-store-body">

    <!-- Atmospheric Backdrop -->
    <div class="store-backdrop">
        <img src="/images/astrolabe-bg.jpg" alt="Archipelago Vaults" class="store-bg-img" style="opacity: 0.85;">
        <div class="store-vignette"></div>
    </div>

    <!-- Reusable Main Navigation Bar -->
    <%- include("partials/header") %>

    <main class="favorites-wrapper" style="max-width: 1200px; margin: 96px auto 30px auto; padding: 0 20px;">

        <!-- Breadcrumbs -->
        <nav class="detail-nav-bar" aria-label="Breadcrumb Navigation" style="margin-bottom: 24px;">
            <div class="detail-breadcrumbs">
                <a href="/home" class="crumb-link">Sea Chart</a>
                <span class="crumb-separator">›</span>
                <span class="crumb-current">Captain's Favorites</span>
            </div>
            <div class="store-header-controls">
                <div class="doubloons-pill">
                    <span class="coin-icon">❤️</span>
                    <span><%= products.length %> Saved Treasures</span>
                </div>
                <a href="/home" class="btn-store-cart" style="text-decoration: none;" title="Return to Sea Chart">
                    <span>🗺️ SEA CHART</span>
                </a>
            </div>
        </nav>

        <section class="favorites-container">
            <header class="favorites-header" style="text-align: center; margin-bottom: 32px;">
                <h1 style="font-family: 'Cinzel', serif; font-size: 2.2rem; color: #ffd700; letter-spacing: 1px; margin-bottom: 8px;">
                    CAPTAIN'S FAVORITES
                </h1>
                <p style="color: #cbb493; font-size: 1rem;">
                    Treasures and legendary relics marked for future voyages across the archipelago.
                </p>
            </header>

            <% if (!products || products.length === 0) { %>
                <!-- Empty State -->
                <div class="favorites-empty-card" style="background: rgba(14, 8, 12, 0.92); border: 1px solid rgba(212, 147, 57, 0.35); border-radius: 12px; padding: 60px 24px; text-align: center; max-width: 600px; margin: 40px auto; box-shadow: 0 16px 48px rgba(0,0,0,0.7);">
                    <div style="font-size: 3.5rem; margin-bottom: 16px;">⚓</div>
                    <h2 style="font-family: 'Cinzel', serif; color: #ffd700; font-size: 1.5rem; margin-bottom: 12px;">
                        NO TREASURES MARKED YET
                    </h2>
                    <p style="color: #bfa78a; font-size: 0.95rem; line-height: 1.6; margin-bottom: 28px;">
                        The archipelago harbors countless ancient relics, weapons, and provisions. Set sail across the six trading ports and mark your favored wares.
                    </p>
                    <a href="/home" class="btn-detail-add-cart" style="display: inline-block; padding: 12px 28px; text-decoration: none;">
                        <span>🗺️ EXPLORE THE ISLANDS</span>
                    </a>
                </div>
            <% } else { %>
                <!-- Products Grid -->
                <div class="favorites-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
                    <% products.forEach(product => { %>
                        <article class="store-card" style="background: rgba(16, 10, 14, 0.92); border: 1px solid rgba(212, 147, 57, 0.35); border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                            <div class="store-card-image" style="height: 200px; position: relative; background: radial-gradient(circle, rgba(212,147,57,0.12), transparent); display: flex; align-items: center; justify-content: center; padding: 14px;">
                                <img src="<%= product.image || '/images/items/default-relic.png' %>"
                                     alt="<%= product.name %>"
                                     style="max-height: 100%; max-width: 100%; object-fit: contain;"
                                     loading="lazy"
                                     decoding="async">
                                <span style="position: absolute; top: 10px; left: 10px; font-size: 11px; background: rgba(0,0,0,0.75); border: 1px solid rgba(212,147,57,0.4); padding: 3px 8px; border-radius: 4px; color: #ffd57e; font-family: 'Cinzel', serif;">
                                    <%= (product.island || 'Archipelago').toUpperCase() %>
                                </span>
                            </div>

                            <div class="store-card-body" style="padding: 18px; flex: 1; display: flex; flex-direction: column;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                    <span style="color: #ffd700; font-size: 12px;"><%= product.rating || '★★★★★' %></span>
                                    <span style="font-family: 'Cinzel', serif; font-size: 14px; font-weight: 700; color: #ffd700;">
                                        🪙 <%= product.price %> Doubloons
                                    </span>
                                </div>

                                <h3 style="font-family: 'Cinzel', serif; font-size: 1.1rem; color: #fff; margin-bottom: 8px;">
                                    <a href="/product/<%= product.slug || product._id %>" style="color: inherit; text-decoration: none;">
                                        <%= product.name %>
                                    </a>
                                </h3>

                                <p style="color: #bfa78a; font-size: 0.85rem; line-height: 1.5; margin-bottom: 16px; flex: 1;">
                                    <%= product.description ? (product.description.slice(0, 90) + (product.description.length > 90 ? '...' : '')) : '' %>
                                </p>

                                <div class="store-card-actions" style="display: flex; gap: 8px; flex-wrap: wrap;">
                                    <form action="/cart/add" method="POST" style="flex: 1;">
                                        <input type="hidden" name="productId" value="<%= product._id %>">
                                        <input type="hidden" name="quantity" value="1">
                                        <button type="submit" class="btn-add-cart" style="width: 100%; padding: 8px 12px; font-size: 12px;">
                                            <span>🛒 STOW IN HOLD</span>
                                        </button>
                                    </form>

                                    <form action="/favorites/<%= product._id %>/toggle" method="POST">
                                        <button type="submit" class="btn-store-cart" title="Remove from Favorites" style="padding: 8px 12px; background: rgba(220, 53, 69, 0.2); border-color: rgba(220, 53, 69, 0.5); color: #ff9999;">
                                            ✕
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>

    </main>

</body>
</html>
