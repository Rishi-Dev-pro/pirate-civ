<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page_title || "Captain's Favorites | Pirate-Civ" %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css?v=p3_corsair_v1">
    <link rel="stylesheet" href="/css/island-store.css?v=detail_v1">
    <link rel="stylesheet" href="/css/favorites.css?v=fav_v1">
</head>
<body class="island-store-body">

    <!-- Atmospheric Backdrop -->
    <div class="store-backdrop">
        <img src="/images/astrolabe-bg.jpg" alt="Archipelago Vaults" class="store-bg-img" style="opacity: 0.85;">
        <div class="store-vignette"></div>
    </div>

    <!-- Reusable Main Navigation Bar -->
    <%- include("partials/header") %>

    <main class="favorites-wrapper">

        <!-- Breadcrumbs -->
        <nav class="detail-nav-bar" aria-label="Breadcrumb Navigation" style="margin-bottom: 24px;">
            <div class="detail-breadcrumbs">
                <a href="/home" class="crumb-link">Sea Chart</a>
                <span class="crumb-separator">›</span>
                <span class="crumb-current">Captain's Favorites</span>
            </div>
            <div class="store-header-controls">
                <div class="doubloons-pill">
                    <span class="coin-icon">❤️</span>
                    <span id="favCountBadge"><%= products.length %> Saved Treasures</span>
                </div>
                <a href="/home" class="btn-store-cart" style="text-decoration: none;" title="Return to Sea Chart">
                    <span>🗺️ SEA CHART</span>
                </a>
            </div>
        </nav>

        <section class="favorites-container">
            <!-- Dedicated High-Contrast Hero Card -->
            <header class="favorites-hero-card">
                <div class="favorites-title-badge">
                    <span class="favorites-badge-gem">✦</span>
                    <span>TREASURE VAULT LEDGER</span>
                    <span class="favorites-badge-gem">✦</span>
                </div>
                <h1 class="favorites-title">CAPTAIN'S FAVORITES</h1>
                <p class="favorites-subtitle">
                    Treasures and legendary relics marked for future voyages across the sovereign archipelago.
                </p>
            </header>

            <% if (!products || products.length === 0) { %>
                <!-- Empty State -->
                <div class="favorites-empty-card">
                    <div class="empty-icon-wrap">⚓</div>
                    <h2 class="empty-title">
                        NO TREASURES MARKED YET
                    </h2>
                    <p class="empty-desc">
                        The archipelago harbors countless ancient relics, weapons, and provisions. Set sail across the six trading ports and mark your favored wares.
                    </p>
                    <a href="/home" class="btn-detail-add-cart" style="display: inline-block; padding: 12px 28px; text-decoration: none;">
                        <span>🗺️ EXPLORE THE ISLANDS</span>
                    </a>
                </div>
            <% } else { %>
                <!-- Products Grid -->
                <div class="favorites-grid">
                    <% products.forEach(product => { %>
                        <article class="favorite-item-card" id="favorite-card-<%= product._id %>">
                            <!-- Card Header: Island Tag + Dismiss Action -->
                            <div class="favorite-card-top">
                                <span class="favorite-island-tag">
                                    <span style="opacity: 0.85;">🧭</span> <%= (product.island || 'Archipelago').toUpperCase() %>
                                </span>
                                <form action="/favorites/<%= product._id %>/toggle" method="POST" class="remove-fav-form">
                                    <button type="submit" class="btn-remove-favorite" title="Remove from Favorites" aria-label="Remove <%= product.name || product.title %> from Favorites">
                                        <span>✕</span>
                                        <span>DISMISS</span>
                                    </button>
                                </form>
                            </div>

                            <!-- Relic Showcase Asset -->
                            <a href="/product/<%= product.slug || product._id %>" class="favorite-asset-link" title="Inspect <%= product.name || product.title %>">
                                <div class="favorite-asset-box">
                                    <div class="favorite-asset-glow"></div>
                                    <img src="<%= product.image || '/images/items/default-relic.png' %>"
                                         alt="<%= product.name || product.title %>"
                                         class="favorite-asset-img"
                                         onerror="this.onerror=null; this.src='/images/items/default-relic.png';"
                                         loading="lazy"
                                         decoding="async">
                                </div>
                            </a>

                            <!-- Card Body Information -->
                            <div class="favorite-card-info">
                                <div class="favorite-meta-row">
                                    <span class="favorite-rating"><%= product.rating || '★★★★★' %></span>
                                    <span class="favorite-price">
                                        🪙 <%= product.price %> Doubloons
                                    </span>
                                </div>

                                <h3 class="favorite-item-title">
                                    <a href="/product/<%= product.slug || product._id %>" class="favorite-title-link">
                                        <%= product.name || product.title %>
                                    </a>
                                </h3>

                                <% if (product.seller && (product.seller.storeName || product.seller.name)) { %>
                                    <div class="favorite-seller-badge">
                                        <span class="seller-icon">⚓</span>
                                        <span><%= product.seller.storeName || product.seller.name %></span>
                                    </div>
                                <% } %>

                                <p class="favorite-item-desc">
                                    <%= product.description ? (product.description.slice(0, 95) + (product.description.length > 95 ? '...' : '')) : 'Rare antiquities recovered from uncharted sea waters.' %>
                                </p>

                                <div class="favorite-card-actions">
                                    <form action="/cart/add" method="POST" class="favorite-stow-form">
                                        <input type="hidden" name="productId" value="<%= product._id %>">
                                        <input type="hidden" name="quantity" value="1">
                                        <button type="submit" class="btn-favorite-stow">
                                            <span>🛒 STOW IN HOLD</span>
                                        </button>
                                    </form>

                                    <a href="/product/<%= product.slug || product._id %>" class="btn-favorite-inspect" title="Inspect <%= product.name %>">
                                        <span>🔍 DETAILS</span>
                                    </a>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>

    </main>

</body>
</html>
