<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page_title || "PIRATE-CIV // MERCHANT CARGO MANIFEST" %></title>

    <!-- Google Fonts: Cinzel & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Developer Realm Stylesheet -->
    <link rel="stylesheet" href="/css/developer.css?v=cinematic_chamber_v2">
</head>

<body class="dev-body">

    <div class="dev-container">

        <!-- ===================================================================
             TOP COMMAND BAR (COMMAND DECK)
             =================================================================== -->
        <header class="dev-topbar" role="banner">
            <div class="dev-branding">
                <span class="dev-realm-tag">PIRATE-CIV // THE HIDDEN CHAMBER</span>
                <h1 class="dev-title-main">
                    <span>DEVELOPER REALM</span>
                    <span class="dev-title-subtext">SOVEREIGN ARCHITECT</span>
                </h1>
            </div>

            <div class="dev-actions">
                <div class="dev-status-pill" title="Security Perimeter Active">
                    <span class="dev-status-indicator"></span>
                    <span>REALM SECURED // AUTHENTICATED</span>
                </div>

                <a href="/home" class="dev-btn" id="btnReturnSeaChart">
                    <span>⚓ RETURN TO SEA CHART</span>
                </a>

                <a href="/logout" class="dev-btn dev-btn-disconnect" id="btnDevDisconnect">
                    <span>⏻ DISCONNECT</span>
                </a>
            </div>
        </header>

        <!-- ===================================================================
             BRASS NAUTICAL NAVIGATION STRIP
             =================================================================== -->
        <nav class="dev-subnav" aria-label="Developer Navigation">
            <a href="/developer/dashboard" class="dev-nav-item">
                <span>COMMAND CHAMBER</span>
            </a>
            <a href="/developer/sellers/applications" class="dev-nav-item">
                <span>MERCHANT CHARTERS</span>
                <% if (typeof pendingSellersCount !== 'undefined' && pendingSellersCount > 0) { %>
                    <span class="dev-nav-badge-pending"><%= pendingSellersCount %></span>
                <% } %>
            </a>
            <a href="/developer/people" class="dev-nav-item active">
                <span>THE PEOPLE</span>
            </a>
        </nav>

        <!-- ===================================================================
             BREADCRUMB / BACK LINK
             =================================================================== -->
        <div class="dev-breadcrumb">
            <a href="/developer/people" class="dev-breadcrumb-link">&larr; BACK TO PEOPLE REGISTRY</a>
        </div>

        <!-- ===================================================================
             SELLER PROFILE OVERVIEW CARD
             =================================================================== -->
        <section class="dev-profile-banner">
            <div class="dev-profile-header">
                <div>
                    <span class="dev-hero-kicker">MERCHANT WAREHOUSE OVERSIGHT</span>
                    <h2 class="dev-section-title"><%= seller.storeName || seller.name %></h2>
                    <p class="dev-section-desc">
                        Proprietor: <strong><%= seller.name %></strong> (<%= seller.email %>) &bull; Home Island: <strong><%= seller.homeIsland || "Astrolabe" %></strong> &bull; Charter: <strong><%= seller.sellerStatus || "approved" %></strong>
                    </p>
                </div>
                <div class="dev-profile-meta">
                    <span class="dev-count-tag" style="font-size: 0.9rem;"><%= products ? products.length : 0 %> Listed Wares</span>
                </div>
            </div>
        </section>

        <!-- ===================================================================
             PRODUCT LISTINGS TABLE (READ-ONLY)
             =================================================================== -->
        <div class="dev-block-header">
            <h3 class="dev-grid-title" style="margin: 0;">
                ACTIVE & LISTED INVENTORY (READ-ONLY)
            </h3>
        </div>

        <% if (products && products.length > 0) { %>
            <div class="dev-table-wrapper">
                <table class="dev-table" id="tableSellerProducts">
                    <thead>
                        <tr>
                            <th>CARGO WARES</th>
                            <th>ISLAND / PORT</th>
                            <th>CATEGORY</th>
                            <th>PRICE</th>
                            <th>STOCK LEVEL</th>
                            <th>AVAILABILITY</th>
                            <th>LISTED DATE</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% products.forEach(product => { %>
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <% if (product.image) { %>
                                            <img src="<%= product.image %>" alt="" style="width: 38px; height: 38px; border-radius: 4px; object-fit: cover; border: 1px solid var(--dev-border-subtle);">
                                        <% } %>
                                        <div>
                                            <span class="dev-table-cell-bold"><%= product.name %></span>
                                            <% if (product.slug) { %>
                                                <div class="dev-table-cell-mono" style="font-size: 0.72rem; color: var(--dev-muted);"><%= product.slug %></div>
                                            <% } %>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="dev-table-cell-brass"><%= product.island || "Unspecified" %></span>
                                </td>
                                <td>
                                    <span style="text-transform: capitalize;"><%= product.category || "General" %></span>
                                </td>
                                <td>
                                    <span class="dev-table-cell-bold" style="color: var(--dev-gold-bright);"><%= product.price %> Doubloons</span>
                                </td>
                                <td>
                                    <span><%= product.stock %> units</span>
                                </td>
                                <td>
                                    <% if (product.isAvailable) { %>
                                        <span class="dev-status-tag tag-approved">Available</span>
                                    <% } else { %>
                                        <span class="dev-status-tag tag-rejected">Depleted</span>
                                    <% } %>
                                </td>
                                <td>
                                    <%= new Date(product.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="dev-empty-state">
                <span class="dev-empty-title">No Wares Registered in Merchant Hold</span>
                <p class="dev-empty-desc">This merchant currently has no active products listed in the marketplace ledger.</p>
            </div>
        <% } %>

    </div>

</body>

</html>
