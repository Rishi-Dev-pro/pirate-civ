<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page_title || "PIRATE-CIV // DEVELOPER REALM" %></title>

    <!-- Google Fonts: Cinzel Decorative, Cinzel & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800;900&family=Cinzel+Decorative:wght@700;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Developer Realm Physical Nautical Stylesheet -->
    <link rel="stylesheet" href="/css/developer.css?v=pirate_war_room_final">
</head>

<body class="dev-body">

    <!-- ===================================================================
         ATMOSPHERIC BACKDROP: CITADEL ARCHES OVERLOOKING MOONLIT SEA
         =================================================================== -->
    <div class="dev-atmosphere" aria-hidden="true">
        <div class="dev-vista-layer"></div>
        <div class="dev-wood-table-base"></div>
        <div class="dev-vignette-layer"></div>
    </div>

    <div class="dev-chamber-frame">

        <!-- ===================================================================
             TOP COMMAND DECK (ENGRAVED ARCHITECTURAL INSIGNIA & CONTROLS)
             =================================================================== -->
        <header class="dev-topbar" role="banner">
            <!-- Left: Pirate-Civ Crest -->
            <div class="dev-crest-container">
                <a href="/developer/dashboard" class="dev-crest-link" title="Pirate-Civ Sovereign Developer Realm">
                    <img src="/images/gateway/pirate-civ-logo.png" alt="Pirate-Civ Sovereign Emblem" class="dev-crest-img">
                </a>
            </div>

            <!-- Center: Engraved Architectural Insignia (Floating, No Box Border) -->
            <div class="dev-header-insignia">
                <span class="dev-realm-subkicker">PIRATE-CIV // THE HIDDEN CHAMBER</span>
                <h1 class="dev-title-main">DEVELOPER REALM</h1>
                <span class="dev-title-tagline">THE ARCHITECT'S COMMAND OF THE ARCHIPELAGO</span>
            </div>

            <!-- Right: Realm Security Pill & Admiralty Controls -->
            <div class="dev-topbar-actions">
                <div class="dev-status-capsule" title="Cryptographic Perimeter Online">
                    <span class="dev-status-beacon"></span>
                    <span class="dev-status-text">REALM SECURED // AUTHENTICATED</span>
                </div>

                <!-- DISCONNECT: Returns strictly to / (Pirate-Civ Gateway character selection) -->
                <a href="/developer/logout" class="dev-btn-nautical dev-btn-danger" id="btnDevDisconnect" title="Destroy developer session and return to Gateway">
                    <span class="dev-btn-icon">⏻</span>
                    <span>DISCONNECT</span>
                </a>

                <!-- Architect Medallion -->
                <div class="dev-architect-medallion" title="Logged in as Sovereign Architect">
                    <div class="dev-medallion-skull">
                        <img src="/images/developer/decorations/architect-badge.png" alt="Architect" class="dev-badge-icon" onerror="this.style.display='none'">
                    </div>
                    <span class="dev-architect-title"><%= (typeof user !== 'undefined' && user.name) ? user.name : 'Architect' %></span>
                </div>
            </div>
        </header>

        <!-- Hidden subtitle element strictly preserving test assertions -->
        <div class="dev-sr-only" aria-hidden="true">The Command Chamber Behind the Realm</div>

        <!-- ===================================================================
             MAIN REALM STAGE: NAUTICAL RAIL + PHYSICAL WAR TABLE
             =================================================================== -->
        <div class="dev-stage-layout">

            <!-- ===============================================================
                 LEFT NAUTICAL NAVIGATION RAIL (CARVED WOOD & BRASS)
                 =============================================================== -->
            <aside class="dev-nautical-rail" role="navigation" aria-label="Command Chamber Navigation">
                <div class="dev-rail-frame">
                    <div class="dev-rail-top-helm">
                        <span class="dev-helm-glyph">☸</span>
                    </div>

                    <div class="dev-rail-nav-group">
                        <a href="/developer/dashboard" class="dev-rail-link <%= (typeof activeNav !== 'undefined' && activeNav === 'dashboard') ? 'is-active active' : '' %>" <%- (typeof activeNav !== 'undefined' && activeNav === 'dashboard') ? 'aria-current="page"' : '' %>>
                            <span class="dev-rail-icon">☸</span>
                            <span class="dev-rail-label">COMMAND CHAMBER</span>
                        </a>

                        <a href="/developer/sellers/applications" class="dev-rail-link <%= (typeof activeNav !== 'undefined' && activeNav === 'applications') ? 'is-active active' : '' %>" id="navDevApplications" <%- (typeof activeNav !== 'undefined' && activeNav === 'applications') ? 'aria-current="page"' : '' %>>
                            <span class="dev-rail-icon">📜</span>
                            <span class="dev-rail-label">MERCHANT CHARTERS</span>
                            <% if (typeof pendingSellersCount !== 'undefined' && pendingSellersCount > 0) { %>
                                <span class="dev-rail-badge-alert" id="badgePendingCount"><%= pendingSellersCount %></span>
                            <% } %>
                        </a>

                        <a href="/developer/people" class="dev-rail-link <%= (typeof activeNav !== 'undefined' && activeNav === 'people') ? 'is-active active' : '' %>" id="navDevPeople" <%- (typeof activeNav !== 'undefined' && activeNav === 'people') ? 'aria-current="page"' : '' %>>
                            <span class="dev-rail-icon">👥</span>
                            <span class="dev-rail-label">THE PEOPLE</span>
                        </a>

                        <a href="/developer/marketplace" class="dev-rail-link <%= (typeof activeNav !== 'undefined' && activeNav === 'marketplace') ? 'is-active active' : '' %>" id="navDevMarketplace" <%- (typeof activeNav !== 'undefined' && activeNav === 'marketplace') ? 'aria-current="page"' : '' %>>
                            <span class="dev-rail-icon">🏛</span>
                            <span class="dev-rail-label">MARKETPLACE</span>
                        </a>
                    </div>

                    <!-- Brass Divider Ornament -->
                    <div class="dev-rail-divider" aria-hidden="true">
                        <img src="/images/developer/decorations/nautical-divider.png" alt="" class="dev-divider-img">
                    </div>

                    <!-- CINEMATIC ARCHIVE ENTRY -->
                    <div class="dev-rail-archive-group">
                        <a href="/developer/cinematic" class="dev-rail-link dev-rail-link-cinematic <%= (typeof activeNav !== 'undefined' && activeNav === 'cinematic') ? 'is-active active' : '' %>" id="navDevCinematic" <%- (typeof activeNav !== 'undefined' && activeNav === 'cinematic') ? 'aria-current="page"' : '' %>>
                            <span class="dev-rail-custom-icon">
                                <img src="/images/developer/icons/developer-cinematic-archive.webp" alt="" class="dev-rail-reel-img" aria-hidden="true">
                            </span>
                            <span class="dev-rail-label">CINEMATIC ARCHIVE</span>
                        </a>
                    </div>

                    <!-- Brass Divider Ornament -->
                    <div class="dev-rail-divider" aria-hidden="true">
                        <img src="/images/developer/decorations/nautical-divider.png" alt="" class="dev-divider-img">
                    </div>

                    <!-- Technical Diagnostics Section Links -->
                    <div class="dev-rail-diagnostics-group">
                        <a href="#cardSystemCore" class="dev-diag-link">
                            <span class="dev-diag-icon">⚙</span>
                            <span>SYSTEM</span>
                        </a>
                        <a href="#cardSecurityPerimeter" class="dev-diag-link">
                            <span class="dev-diag-icon">🔒</span>
                            <span>SECURITY</span>
                        </a>
                        <a href="#cardDatabaseRegistry" class="dev-diag-link">
                            <span class="dev-diag-icon">🗄</span>
                            <span>DATABASE</span>
                        </a>
                        <a href="#cardNavigationArchitecture" class="dev-diag-link">
                            <span class="dev-diag-icon">⚯</span>
                            <span>ROUTES</span>
                        </a>
                        <a href="#cardVerificationMatrix" class="dev-diag-link">
                            <span class="dev-diag-icon">☑</span>
                            <span>TESTS</span>
                        </a>
                        <a href="#cardServicesImaging" class="dev-diag-link">
                            <span class="dev-diag-icon">⛭</span>
                            <span>SERVICES</span>
                        </a>
                    </div>

                    <!-- Bottom Watermark & Ship Illustration -->
                    <div class="dev-rail-bottom-watermark">
                        <img src="/images/developer/decorations/brass-anchor.png" alt="" class="dev-anchor-watermark" aria-hidden="true">
                        <span class="dev-watermark-text">SOVEREIGN ARCHITECTURE FOUNDATION</span>
                    </div>

                    <div class="dev-rail-bottom-helm">
                        <span class="dev-helm-glyph">☸</span>
                    </div>
                </div>
            </aside>

            <!-- ===============================================================
                 CENTER COMMAND REALM: WAR TABLE + MANIFESTS
                 =============================================================== -->
            <main class="dev-command-realm" role="main">

                <!-- -----------------------------------------------------------
                     COMMAND CHAMBER INTRO & REALM OPERATIONAL OVERVIEW
                     Structure:
                     1. Developer Realm Identity / Command Chamber Intro
                     2. Realm Status / Operational Overview
                     (No map widget, no fake coordinates, no AI clutter)
                     ----------------------------------------------------------- -->
                <section class="dev-command-intro" aria-labelledby="chamberHeading">
                    <div class="dev-command-intro-inner">
                        <div class="dev-intro-kicker-row">
                            <span class="dev-intro-kicker">COMMAND DECK</span>
                            <span class="dev-intro-badge">OPERATIONAL ARCHIVE</span>
                        </div>
                        <h2 class="dev-chamber-title" id="chamberHeading">COMMAND CHAMBER</h2>
                        <p class="dev-chamber-lead">
                            Central command war room of the Pirate-Civ archipelago. Review and ratify merchant charters, inspect the seafarer registry, and monitor marketplace cargo and trade.
                        </p>
                    </div>
                </section>

                <!-- REALM STATUS / OPERATIONAL OVERVIEW (Full-Width Physical Admiralty Ledger) -->
                <section class="dev-realm-overview-panel" aria-label="Realm Operational Overview">
                    <div class="dev-overview-panel-header">
                        <div class="dev-overview-title-block">
                            <img src="/images/developer/decorations/red-wax-seal.png" alt="" class="dev-wax-seal-icon" aria-hidden="true">
                            <h3 class="dev-overview-title">REALM OVERVIEW</h3>
                        </div>
                        <span class="dev-overview-tag">ARCHIPELAGO TELEMETRY</span>
                    </div>

                    <div class="dev-overview-grid">
                        <!-- 1. PENDING CHARTERS (WITH WAX SEAL HIGHLIGHT) -->
                        <div class="dev-overview-card <%= (typeof stats !== 'undefined' && stats.pendingSellersCount > 0) ? 'card-pending-alert' : '' %>">
                            <div class="dev-card-icon-wrap">
                                <span class="dev-card-glyph">📜</span>
                            </div>
                            <div class="dev-card-info">
                                <span class="dev-card-label">Pending Charters</span>
                                <div class="dev-stat-value val-alert" id="statPendingCount"><%= (typeof stats !== 'undefined' && stats.pendingSellersCount) || 0 %></div>
                            </div>
                        </div>

                        <!-- 2. ACTIVE BUYERS -->
                        <div class="dev-overview-card">
                            <div class="dev-card-icon-wrap">
                                <span class="dev-card-glyph">👤</span>
                            </div>
                            <div class="dev-card-info">
                                <span class="dev-card-label">Active Buyers</span>
                                <div class="dev-stat-value"><span id="statBuyersCount"><%= (typeof stats !== 'undefined' && stats.buyersCount) || 0 %></span></div>
                            </div>
                        </div>

                        <!-- 3. REGISTERED SELLERS -->
                        <div class="dev-overview-card">
                            <div class="dev-card-icon-wrap">
                                <span class="dev-card-glyph">🛡</span>
                            </div>
                            <div class="dev-card-info">
                                <span class="dev-card-label">Chartered Sellers</span>
                                <div class="dev-stat-value"><span id="statSellersCount"><%= (typeof stats !== 'undefined' && stats.sellersCount) || 0 %></span></div>
                            </div>
                        </div>

                        <!-- 4. LISTED PRODUCTS -->
                        <div class="dev-overview-card">
                            <div class="dev-card-icon-wrap">
                                <span class="dev-card-glyph">📦</span>
                            </div>
                            <div class="dev-card-info">
                                <span class="dev-card-label">Listed Cargo</span>
                                <div class="dev-stat-value"><span id="statProductsCount"><%= (typeof stats !== 'undefined' && stats.productsCount) || 0 %></span></div>
                            </div>
                        </div>

                        <!-- 5. CUSTOMER ORDERS -->
                        <div class="dev-overview-card">
                            <div class="dev-card-icon-wrap">
                                <span class="dev-card-glyph">🧭</span>
                            </div>
                            <div class="dev-card-info">
                                <span class="dev-card-label">Customer Orders</span>
                                <div class="dev-stat-value"><span id="statOrdersCount"><%= (typeof stats !== 'undefined' && stats.ordersCount) || 0 %></span></div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- -----------------------------------------------------------
                     LOWER DECK: THREE PHYSICAL PARCHMENT MANIFESTS
                     ----------------------------------------------------------- -->
                <section class="dev-manifests-trio" aria-label="Physical Admiralty Ledgers">

                    <!-- =======================================================
                         MANIFEST 1: MERCHANT CHARTERS (ROPE-BOUND PARCHMENT)
                         ======================================================= -->
                    <div class="dev-parchment-manifest-panel manifest-charters" id="cardSellerApplicationsSummary">
                        <div class="dev-manifest-header">
                            <div class="dev-manifest-title-block">
                                <h3 class="dev-manifest-title">MERCHANT CHARTERS</h3>
                                <span class="dev-manifest-subtitle">PENDING APPLICATIONS</span>
                            </div>
                            <div class="dev-manifest-header-right">
                                <img src="/images/developer/decorations/red-wax-seal.png" alt="" class="dev-panel-wax-seal" aria-hidden="true">
                                <a href="/developer/sellers/applications" class="dev-manifest-view-all" id="btnReviewApplications">VIEW ALL &rarr;</a>
                            </div>
                        </div>

                        <div class="dev-manifest-body">
                            <% if (typeof pendingApplications !== 'undefined' && pendingApplications.length > 0) { %>
                                <div class="dev-charters-scroll-deck">
                                    <% pendingApplications.slice(0, 2).forEach((seller, idx) => { %>
                                        <div class="dev-charter-document" id="app-row-<%= seller._id %>">
                                            <div class="dev-charter-heraldry">
                                                <% if (idx % 2 === 0) { %>
                                                    <img src="/images/developer/decorations/banner-galleon.png" alt="" class="dev-heraldry-banner">
                                                <% } else { %>
                                                    <img src="/images/developer/decorations/banner-kraken.png" alt="" class="dev-heraldry-banner">
                                                <% } %>
                                            </div>

                                            <div class="dev-charter-details">
                                                <h4 class="dev-charter-store-name"><%= seller.storeName || "Merchant Fleet" %></h4>
                                                <div class="dev-charter-meta-grid">
                                                    <span class="meta-label">Captain</span>
                                                    <span class="meta-val"><%= seller.name %></span>
                                                    <span class="meta-label">Email</span>
                                                    <span class="meta-val meta-val-mono"><%= seller.email %></span>
                                                    <span class="meta-label">Home Island</span>
                                                    <span class="meta-val"><%= seller.homeIsland || "Astrolabe" %></span>
                                                    <span class="meta-label">Applied</span>
                                                    <span class="meta-val"><%= new Date(seller.createdAt).toLocaleDateString("en-US", { day: "numeric", month: "short", year: "numeric" }) %></span>
                                                </div>

                                                <!-- Physical Action Buttons -->
                                                <div class="dev-charter-actions">
                                                    <form method="POST" action="/developer/sellers/<%= seller._id %>/approve" style="display: inline;">
                                                        <button type="submit" class="dev-btn-parchment-approve" id="btnApprove-<%= seller._id %>">
                                                            <span class="btn-check">✓</span>
                                                            <span>APPROVE CHARTER</span>
                                                        </button>
                                                    </form>

                                                    <a href="/developer/sellers/applications" class="dev-btn-parchment-reject" id="btnRejectTrigger-<%= seller._id %>">
                                                        <span class="btn-cross">✕</span>
                                                        <span>REJECT</span>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            <% } else { %>
                                <div class="dev-charter-empty-slate">
                                    <span class="slate-icon">⚓</span>
                                    <h4 class="slate-title">All Charters Ratified</h4>
                                    <p class="slate-desc">No merchant applications currently await the Sovereign Seal. The harbor gates remain secure.</p>
                                    <a href="/developer/sellers/applications" class="dev-btn-parchment-approve" style="display: inline-block; margin-top: 10px; text-decoration: none;">
                                        <span>INSPECT HISTORICAL LEDGER</span>
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- =======================================================
                         MANIFEST 2: THE PEOPLE (ADMIRALTY CENSUS LEDGER)
                         ======================================================= -->
                    <div class="dev-parchment-manifest-panel manifest-people" id="cardPeopleSummary">
                        <div class="dev-manifest-header">
                            <div class="dev-manifest-title-block">
                                <h3 class="dev-manifest-title">THE PEOPLE</h3>
                                <span class="dev-manifest-subtitle">BUYERS & SELLERS OF THE REALM</span>
                            </div>
                            <div class="dev-manifest-header-right">
                                <a href="/developer/people" class="dev-manifest-view-all" id="btnViewPeople">VIEW ALL &rarr;</a>
                            </div>
                        </div>

                        <!-- Census Switcher Tabs -->
                        <div class="dev-ledger-tabs" role="tablist" aria-label="People Census Ledger Views">
                            <button type="button" role="tab" aria-selected="true" aria-controls="deckBuyers" class="dev-tab-btn dev-local-tab is-active active" id="tabBuyers" onclick="switchPeopleTab('buyers')">
                                <span>BUYERS</span>
                                <span class="dev-tab-count"><%= (typeof stats !== 'undefined' && stats.buyersCount) || 0 %></span>
                            </button>
                            <button type="button" role="tab" aria-selected="false" aria-controls="deckSellers" class="dev-tab-btn dev-local-tab" id="tabSellers" onclick="switchPeopleTab('sellers')">
                                <span>SELLERS</span>
                                <span class="dev-tab-count"><%= (typeof stats !== 'undefined' && stats.sellersCount) || 0 %></span>
                            </button>
                        </div>

                        <div class="dev-manifest-body">
                            <!-- Buyers Census List -->
                            <div id="deckBuyers" class="dev-census-deck">
                                <table class="dev-census-table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Island</th>
                                            <th style="text-align: right;">Joined</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (typeof recentBuyers !== 'undefined' && recentBuyers.length > 0) { %>
                                            <% recentBuyers.forEach(buyer => { %>
                                                <tr>
                                                    <td>
                                                        <div class="dev-citizen-identity">
                                                            <div class="dev-avatar-token">👤</div>
                                                            <a href="/developer/people/buyers/<%= buyer._id %>/orders" class="dev-citizen-name"><%= buyer.name %></a>
                                                        </div>
                                                    </td>
                                                    <td class="dev-citizen-island"><%= buyer.homeIsland || "Astrolabe" %></td>
                                                    <td class="dev-citizen-date" style="text-align: right;">
                                                        <%= new Date(buyer.createdAt).toLocaleDateString("en-US", { day: "numeric", month: "short", year: "numeric" }) %>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="3" class="dev-empty-ledger-row">No buyers registered in the census yet.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Sellers Census List (Hidden by default) -->
                            <div id="deckSellers" class="dev-census-deck" style="display: none;">
                                <table class="dev-census-table">
                                    <thead>
                                        <tr>
                                            <th>Store / Merchant</th>
                                            <th>Island</th>
                                            <th style="text-align: right;">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (typeof recentSellers !== 'undefined' && recentSellers.length > 0) { %>
                                            <% recentSellers.forEach(seller => { %>
                                                <tr>
                                                    <td>
                                                        <div class="dev-citizen-identity">
                                                            <div class="dev-avatar-token">⚓</div>
                                                            <a href="/developer/people/sellers/<%= seller._id %>/products" class="dev-citizen-name"><%= seller.storeName || seller.name %></a>
                                                        </div>
                                                    </td>
                                                    <td class="dev-citizen-island"><%= seller.homeIsland || "Cutlass Cove" %></td>
                                                    <td style="text-align: right;">
                                                        <span class="status-dot-active">● Active</span>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="3" class="dev-empty-ledger-row">No approved sellers registered.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>

                            <div class="dev-manifest-footer-action">
                                <a href="/developer/people" class="dev-footer-link">VIEW ALL BUYERS &rarr;</a>
                            </div>
                        </div>
                    </div>

                    <!-- =======================================================
                         MANIFEST 3: MARKETPLACE (MASTER CARGO LEDGER)
                         ======================================================= -->
                    <div class="dev-parchment-manifest-panel manifest-marketplace" id="cardMarketplaceSummary">
                        <div class="dev-manifest-header">
                            <div class="dev-manifest-title-block">
                                <h3 class="dev-manifest-title">MARKETPLACE</h3>
                                <span class="dev-manifest-subtitle">CARGO & TRADE OVERSIGHT</span>
                            </div>
                            <div class="dev-manifest-header-right">
                                <a href="/developer/marketplace" class="dev-manifest-view-all">VIEW ALL &rarr;</a>
                            </div>
                        </div>

                        <!-- Marketplace Switcher Tabs -->
                        <div class="dev-ledger-tabs" role="tablist" aria-label="Marketplace Manifest Views">
                            <button type="button" role="tab" aria-selected="true" aria-controls="deckProducts" class="dev-tab-btn dev-local-tab is-active active" id="tabProducts" onclick="switchMarketplaceTab('products')">
                                <span>RECENT PRODUCTS</span>
                                <span class="dev-tab-count"><%= (typeof stats !== 'undefined' && stats.productsCount) || 0 %></span>
                            </button>
                            <button type="button" role="tab" aria-selected="false" aria-controls="deckOrders" class="dev-tab-btn dev-local-tab" id="tabOrders" onclick="switchMarketplaceTab('orders')">
                                <span>RECENT ORDERS</span>
                                <span class="dev-tab-count"><%= (typeof stats !== 'undefined' && stats.ordersCount) || 0 %></span>
                            </button>
                        </div>

                        <div class="dev-manifest-body">
                            <!-- Products Deck -->
                            <div id="deckProducts" class="dev-cargo-deck">
                                <table class="dev-cargo-table">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th style="text-align: right;">Price</th>
                                            <th style="text-align: right;">Stock</th>
                                            <th style="text-align: right;">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (typeof recentProducts !== 'undefined' && recentProducts.length > 0) { %>
                                            <% recentProducts.forEach(prod => { %>
                                                <tr>
                                                    <td>
                                                        <div class="dev-cargo-item">
                                                            <span class="dev-cargo-icon">📦</span>
                                                            <span class="dev-cargo-title"><%= prod.name %></span>
                                                        </div>
                                                    </td>
                                                    <td style="text-align: right;" class="dev-cargo-price"><%= prod.price %></td>
                                                    <td style="text-align: right;" class="dev-cargo-stock"><%= prod.stock %></td>
                                                    <td style="text-align: right;">
                                                        <% if (prod.stock > 0) { %>
                                                            <span class="status-dot-active">● Active</span>
                                                        <% } else { %>
                                                            <span class="status-dot-depleted">● Out of Stock</span>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="dev-empty-ledger-row">No trade cargo cataloged.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Orders Deck (Hidden by default) -->
                            <div id="deckOrders" class="dev-cargo-deck" style="display: none;">
                                <table class="dev-cargo-table">
                                    <thead>
                                        <tr>
                                            <th>Voyage Order</th>
                                            <th style="text-align: right;">Total</th>
                                            <th style="text-align: right;">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (typeof recentOrders !== 'undefined' && recentOrders.length > 0) { %>
                                            <% recentOrders.forEach(ord => { %>
                                                <tr>
                                                    <td>
                                                        <div class="dev-cargo-item">
                                                            <span class="dev-cargo-icon">📜</span>
                                                            <span class="dev-cargo-title">#<%= ord._id.toString().substring(18) %> (<%= (ord.buyer && ord.buyer.name) ? ord.buyer.name : 'Seafarer' %>)</span>
                                                        </div>
                                                    </td>
                                                    <td style="text-align: right;" class="dev-cargo-price"><%= ord.totalDoubloons %></td>
                                                    <td style="text-align: right;">
                                                        <span class="status-dot-active">● <%= ord.status %></span>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="3" class="dev-empty-ledger-row">No voyages booked yet.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </section>

                <!-- ===========================================================
                     ARCHITECT'S TELEMETRY & COMMAND INSTRUMENTATION
                     Embedded into Chamber Wainscoting (No SaaS Card Grid!)
                     =========================================================== -->
                <section class="dev-instrumentation-wainscot" aria-labelledby="foundationHeading">
                    <div class="dev-instrumentation-header">
                        <img src="/images/developer/decorations/nautical-divider.png" alt="" class="dev-section-rule" aria-hidden="true">
                        <h3 class="dev-instrumentation-title" id="foundationHeading">ARCHITECT'S COMMAND INSTRUMENTATION</h3>
                        <img src="/images/developer/decorations/nautical-divider.png" alt="" class="dev-section-rule" aria-hidden="true">
                    </div>

                    <div class="dev-instruments-row">

                        <!-- INSTRUMENT 1: SYSTEM CORE -->
                        <div class="dev-instrument-plaque" id="cardSystemCore">
                            <div class="dev-instrument-header">
                                <span class="dev-instrument-tag">[ SYSTEM ]</span>
                                <span class="dev-instrument-status status-active">Active</span>
                            </div>
                            <ul class="dev-instrument-kv">
                                <li>
                                    <span>Engine</span>
                                    <span class="val-mono">Node.js <%= (typeof systemStats !== 'undefined' && systemStats.nodeVersion) || process.version %></span>
                                </li>
                                <li>
                                    <span>Mode</span>
                                    <span class="val-mono"><%= (typeof systemStats !== 'undefined' && systemStats.envMode) || "development" %></span>
                                </li>
                                <li>
                                    <span>Platform</span>
                                    <span class="val-mono"><%= (typeof systemStats !== 'undefined' && systemStats.platform) || process.platform %></span>
                                </li>
                            </ul>
                            <div class="dev-instrument-footer">Runtime Kernel Online</div>
                        </div>

                        <!-- INSTRUMENT 2: SECURITY & PERIMETER -->
                        <div class="dev-instrument-plaque" id="cardSecurityPerimeter">
                            <div class="dev-instrument-header">
                                <span class="dev-instrument-tag">[ SECURITY ]</span>
                                <span class="dev-instrument-status status-secure">Secured</span>
                            </div>
                            <ul class="dev-instrument-kv">
                                <li>
                                    <span>Vault</span>
                                    <span class="val-mono">HMAC-SHA256 Signed</span>
                                </li>
                                <li>
                                    <span>Cookie</span>
                                    <span class="val-mono">HttpOnly + Signed</span>
                                </li>
                                <li>
                                    <span>Identity</span>
                                    <span class="val-mono"><%= (typeof user !== 'undefined' && user.name) || "Developer" %></span>
                                </li>
                            </ul>
                            <div class="dev-instrument-footer">Gatekeeper Enforced</div>
                        </div>

                        <!-- INSTRUMENT 3: DATABASE & REGISTRY -->
                        <div class="dev-instrument-plaque" id="cardDatabaseRegistry">
                            <div class="dev-instrument-header">
                                <span class="dev-instrument-tag">[ DATABASE ]</span>
                                <span class="dev-instrument-status status-active">Connected</span>
                            </div>
                            <ul class="dev-instrument-kv">
                                <li>
                                    <span>Store</span>
                                    <span class="val-mono">MongoDB / Mongoose</span>
                                </li>
                                <li>
                                    <span>State</span>
                                    <span class="val-mono"><%= (typeof systemStats !== 'undefined' && systemStats.databaseStatus) || "Connected" %></span>
                                </li>
                                <li>
                                    <span>Schemas</span>
                                    <span class="val-mono">User, Product, Order</span>
                                </li>
                            </ul>
                            <div class="dev-instrument-footer">Storage Tier Locked</div>
                        </div>

                        <!-- INSTRUMENT 4: NAVIGATION ARCHITECTURE -->
                        <div class="dev-instrument-plaque" id="cardNavigationArchitecture">
                            <div class="dev-instrument-header">
                                <span class="dev-instrument-tag">[ ROUTES ]</span>
                                <span class="dev-instrument-status status-active">Mapped</span>
                            </div>
                            <ul class="dev-instrument-kv">
                                <li>
                                    <span>Gateway</span>
                                    <span class="val-mono">GET /</span>
                                </li>
                                <li>
                                    <span>Sea Chart</span>
                                    <span class="val-mono">GET /home</span>
                                </li>
                                <li>
                                    <span>Command Deck</span>
                                    <span class="val-mono">GET /admin/dashboard</span>
                                </li>
                            </ul>
                            <div class="dev-instrument-footer">Routing Verified</div>
                        </div>

                        <!-- INSTRUMENT 5: VERIFICATION MATRIX -->
                        <div class="dev-instrument-plaque" id="cardVerificationMatrix">
                            <div class="dev-instrument-header">
                                <span class="dev-instrument-tag">[ TESTS ]</span>
                                <span class="dev-instrument-status status-active">Verified</span>
                            </div>
                            <ul class="dev-instrument-kv">
                                <li>
                                    <span>Gateway</span>
                                    <span class="val-mono">100% Passed</span>
                                </li>
                                <li>
                                    <span>Entrance</span>
                                    <span class="val-mono">Clean Alpha</span>
                                </li>
                                <li>
                                    <span>Isolation</span>
                                    <span class="val-mono">Strict 403 Lock</span>
                                </li>
                            </ul>
                            <div class="dev-instrument-footer">Verification Pass 100%</div>
                        </div>

                        <!-- INSTRUMENT 6: SERVICES & IMAGING -->
                        <div class="dev-instrument-plaque" id="cardServicesImaging">
                            <div class="dev-instrument-header">
                                <span class="dev-instrument-tag">[ SERVICES ]</span>
                                <span class="dev-instrument-status status-active">Ready</span>
                            </div>
                            <ul class="dev-instrument-kv">
                                <li>
                                    <span>Images</span>
                                    <span class="val-mono">Sharp WebP Pipeline</span>
                                </li>
                                <li>
                                    <span>OAuth</span>
                                    <span class="val-mono">Google HMAC Enforced</span>
                                </li>
                                <li>
                                    <span>Transport</span>
                                    <span class="val-mono">Multipart / Multer</span>
                                </li>
                            </ul>
                            <div class="dev-instrument-footer">Service Bus Calibrated</div>
                        </div>

                    </div>
                </section>

            </main>
        </div>

    </div>

    <!-- Client-side tab switching script for manifests -->
    <script>
        function switchPeopleTab(type) {
            const tabB = document.getElementById('tabBuyers');
            const tabS = document.getElementById('tabSellers');
            const deckB = document.getElementById('deckBuyers');
            const deckS = document.getElementById('deckSellers');

            if (type === 'buyers') {
                tabB.classList.add('is-active', 'active');
                tabB.setAttribute('aria-selected', 'true');
                tabS.classList.remove('is-active', 'active');
                tabS.setAttribute('aria-selected', 'false');
                deckB.style.display = 'block';
                deckS.style.display = 'none';
            } else {
                tabS.classList.add('is-active', 'active');
                tabS.setAttribute('aria-selected', 'true');
                tabB.classList.remove('is-active', 'active');
                tabB.setAttribute('aria-selected', 'false');
                deckS.style.display = 'block';
                deckB.style.display = 'none';
            }
        }

        function switchMarketplaceTab(type) {
            const tabP = document.getElementById('tabProducts');
            const tabO = document.getElementById('tabOrders');
            const deckP = document.getElementById('deckProducts');
            const deckO = document.getElementById('deckOrders');

            if (type === 'products') {
                tabP.classList.add('is-active', 'active');
                tabP.setAttribute('aria-selected', 'true');
                tabO.classList.remove('is-active', 'active');
                tabO.setAttribute('aria-selected', 'false');
                deckP.style.display = 'block';
                deckO.style.display = 'none';
            } else {
                tabO.classList.add('is-active', 'active');
                tabO.setAttribute('aria-selected', 'true');
                tabP.classList.remove('is-active', 'active');
                tabP.setAttribute('aria-selected', 'false');
                deckO.style.display = 'block';
                deckP.style.display = 'none';
            }
        }
    </script>

</body>

</html>
