<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page_title || "PIRATE-CIV // THE PEOPLE OF THE ARCHIPELAGO" %></title>

    <!-- Google Fonts: Cinzel & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Developer Realm Stylesheet -->
    <link rel="stylesheet" href="/css/developer.css?v=cinematic_chamber_v2">
</head>

<body class="dev-body">

    <div class="dev-container">

        <!-- ===================================================================
             TOP COMMAND BAR (COMMAND DECK)
             =================================================================== -->
        <header class="dev-topbar" role="banner">
            <div class="dev-branding">
                <span class="dev-realm-tag">PIRATE-CIV // THE HIDDEN CHAMBER</span>
                <h1 class="dev-title-main">
                    <span>DEVELOPER REALM</span>
                    <span class="dev-title-subtext">SOVEREIGN ARCHITECT</span>
                </h1>
            </div>

            <div class="dev-actions">
                <div class="dev-status-pill" title="Security Perimeter Active">
                    <span class="dev-status-indicator"></span>
                    <span>REALM SECURED // AUTHENTICATED</span>
                </div>

                <a href="/home" class="dev-btn" id="btnReturnSeaChart">
                    <span>⚓ RETURN TO SEA CHART</span>
                </a>

                <a href="/logout" class="dev-btn dev-btn-disconnect" id="btnDevDisconnect">
                    <span>⏻ DISCONNECT</span>
                </a>
            </div>
        </header>

        <!-- ===================================================================
             BRASS NAUTICAL NAVIGATION STRIP
             =================================================================== -->
        <nav class="dev-subnav" aria-label="Developer Navigation">
            <a href="/developer/dashboard" class="dev-nav-item <%= (typeof activeNav !== 'undefined' && activeNav === 'dashboard') ? 'active' : '' %>">
                <span>COMMAND CHAMBER</span>
            </a>
            <a href="/developer/sellers/applications" class="dev-nav-item <%= (typeof activeNav !== 'undefined' && activeNav === 'applications') ? 'active' : '' %>" id="navDevApplications">
                <span>MERCHANT CHARTERS</span>
                <% if (typeof pendingSellersCount !== 'undefined' && pendingSellersCount > 0) { %>
                    <span class="dev-nav-badge-pending" id="badgePendingCount"><%= pendingSellersCount %></span>
                <% } %>
            </a>
            <a href="/developer/people" class="dev-nav-item <%= (typeof activeNav !== 'undefined' && activeNav === 'people') ? 'active' : '' %>" id="navDevPeople">
                <span>THE PEOPLE</span>
            </a>
        </nav>

        <!-- ===================================================================
             ARCHIPELAGO CENSUS HEADER
             =================================================================== -->
        <section class="dev-section-header">
            <div>
                <span class="dev-hero-kicker">ARCHIPELAGO CENSUS</span>
                <h2 class="dev-section-title">The People of the Archipelago</h2>
                <p class="dev-section-desc">Active seafarers, explorers, and chartered merchants registered across the sovereign islands.</p>
            </div>
        </section>

        <!-- ===================================================================
             CATEGORY 1: BUYERS (EXPLORERS)
             =================================================================== -->
        <div class="dev-block-header">
            <h3 class="dev-grid-title" style="margin: 0;">
                BUYERS (EXPLORERS)
                <span class="dev-count-tag">(<%= buyers ? buyers.length : 0 %> Registered)</span>
            </h3>
        </div>

        <% if (buyers && buyers.length > 0) { %>
            <div class="dev-table-wrapper">
                <table class="dev-table" id="tableBuyers">
                    <thead>
                        <tr>
                            <th>NAME</th>
                            <th>EMAIL</th>
                            <th>HOME ISLAND</th>
                            <th>REGISTRATION DATE</th>
                            <th>ROLE</th>
                            <th style="text-align: right;">MARKETPLACE HISTORY</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% buyers.forEach(buyer => { %>
                            <tr id="buyer-row-<%= buyer._id %>">
                                <td>
                                    <span class="dev-table-cell-bold"><%= buyer.name %></span>
                                </td>
                                <td>
                                    <span class="dev-table-cell-mono"><%= buyer.email %></span>
                                </td>
                                <td><%= buyer.homeIsland || "Astrolabe" %></td>
                                <td><%= new Date(buyer.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) %></td>
                                <td>
                                    <span class="dev-status-tag tag-buyer">Buyer</span>
                                </td>
                                <td style="text-align: right;">
                                    <a href="/developer/people/buyers/<%= buyer._id %>/orders" class="dev-btn dev-btn-sm" id="btnBuyerPurchases-<%= buyer._id %>">
                                        <span>VIEW PURCHASES &rarr;</span>
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="dev-empty-state">
                <p class="dev-empty-desc">No buyer accounts registered across the archipelago yet.</p>
            </div>
        <% } %>

        <!-- ===================================================================
             CATEGORY 2: SELLERS (MERCHANTS)
             =================================================================== -->
        <div class="dev-block-header" style="margin-top: 52px;">
            <h3 class="dev-grid-title" style="margin: 0;">
                SELLERS (MERCHANTS)
                <span class="dev-count-tag">(<%= sellers ? sellers.length : 0 %> Chartered)</span>
            </h3>
        </div>

        <% if (sellers && sellers.length > 0) { %>
            <div class="dev-table-wrapper">
                <table class="dev-table" id="tableSellers">
                    <thead>
                        <tr>
                            <th>CAPTAIN / MERCHANT</th>
                            <th>EMAIL</th>
                            <th>STORE / FLEET</th>
                            <th>HOME ISLAND</th>
                            <th>CHARTER STATUS</th>
                            <th>REGISTRATION DATE</th>
                            <th style="text-align: right;">PRODUCT LISTINGS</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% sellers.forEach(seller => { %>
                            <tr id="seller-row-<%= seller._id %>">
                                <td>
                                    <span class="dev-table-cell-bold">⚓ <%= seller.name %></span>
                                </td>
                                <td>
                                    <span class="dev-table-cell-mono"><%= seller.email %></span>
                                </td>
                                <td>
                                    <span class="dev-table-cell-brass"><%= seller.storeName || "Unspecified Fleet" %></span>
                                </td>
                                <td><%= seller.homeIsland || "Astrolabe" %></td>
                                <td>
                                    <% if (seller.sellerStatus === 'approved') { %>
                                        <span class="dev-status-tag tag-approved">Approved</span>
                                    <% } else if (seller.sellerStatus === 'pending') { %>
                                        <span class="dev-status-tag tag-pending">Pending</span>
                                    <% } else if (seller.sellerStatus === 'rejected') { %>
                                        <span class="dev-status-tag tag-rejected">Rejected</span>
                                    <% } else { %>
                                        <span class="dev-status-tag"><%= seller.sellerStatus || 'Chartered' %></span>
                                    <% } %>
                                </td>
                                <td><%= new Date(seller.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) %></td>
                                <td style="text-align: right;">
                                    <a href="/developer/people/sellers/<%= seller._id %>/products" class="dev-btn dev-btn-sm" id="btnSellerProducts-<%= seller._id %>">
                                        <span>VIEW PRODUCTS &rarr;</span>
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="dev-empty-state">
                <p class="dev-empty-desc">No merchant accounts registered across the archipelago yet.</p>
            </div>
        <% } %>

    </div>

</body>

</html>
