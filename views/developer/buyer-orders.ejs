<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page_title || "PIRATE-CIV // BUYER VOYAGE RECORD" %></title>

    <!-- Google Fonts: Cinzel & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Developer Realm Stylesheet -->
    <link rel="stylesheet" href="/css/developer.css?v=cinematic_chamber_v2">
</head>

<body class="dev-body">

    <div class="dev-container">

        <!-- ===================================================================
             TOP COMMAND BAR (COMMAND DECK)
             =================================================================== -->
        <header class="dev-topbar" role="banner">
            <div class="dev-branding">
                <span class="dev-realm-tag">PIRATE-CIV // THE HIDDEN CHAMBER</span>
                <h1 class="dev-title-main">
                    <span>DEVELOPER REALM</span>
                    <span class="dev-title-subtext">SOVEREIGN ARCHITECT</span>
                </h1>
            </div>

            <div class="dev-actions">
                <div class="dev-status-pill" title="Security Perimeter Active">
                    <span class="dev-status-indicator"></span>
                    <span>REALM SECURED // AUTHENTICATED</span>
                </div>

                <a href="/home" class="dev-btn" id="btnReturnSeaChart">
                    <span>⚓ RETURN TO SEA CHART</span>
                </a>

                <a href="/logout" class="dev-btn dev-btn-disconnect" id="btnDevDisconnect">
                    <span>⏻ DISCONNECT</span>
                </a>
            </div>
        </header>

        <!-- ===================================================================
             BRASS NAUTICAL NAVIGATION STRIP
             =================================================================== -->
        <nav class="dev-subnav" aria-label="Developer Navigation">
            <a href="/developer/dashboard" class="dev-nav-item">
                <span>COMMAND CHAMBER</span>
            </a>
            <a href="/developer/sellers/applications" class="dev-nav-item">
                <span>MERCHANT CHARTERS</span>
                <% if (typeof pendingSellersCount !== 'undefined' && pendingSellersCount > 0) { %>
                    <span class="dev-nav-badge-pending"><%= pendingSellersCount %></span>
                <% } %>
            </a>
            <a href="/developer/people" class="dev-nav-item active">
                <span>THE PEOPLE</span>
            </a>
        </nav>

        <!-- ===================================================================
             BREADCRUMB / BACK LINK
             =================================================================== -->
        <div class="dev-breadcrumb">
            <a href="/developer/people" class="dev-breadcrumb-link">&larr; BACK TO PEOPLE REGISTRY</a>
        </div>

        <!-- ===================================================================
             BUYER PROFILE OVERVIEW CARD
             =================================================================== -->
        <section class="dev-profile-banner">
            <div class="dev-profile-header">
                <div>
                    <span class="dev-hero-kicker">BUYER PURCHASE LEDGER</span>
                    <h2 class="dev-section-title"><%= buyer.name %></h2>
                    <p class="dev-section-desc">
                        Account: <strong><%= buyer.email %></strong> &bull; Home Island: <strong><%= buyer.homeIsland || "Astrolabe" %></strong> &bull; Registered: <strong><%= new Date(buyer.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) %></strong>
                    </p>
                </div>
                <div class="dev-profile-meta">
                    <span class="dev-count-tag" style="font-size: 0.9rem;"><%= orders ? orders.length : 0 %> Orders Recorded</span>
                </div>
            </div>
        </section>

        <!-- ===================================================================
             ORDER HISTORY TABLE (READ-ONLY)
             =================================================================== -->
        <div class="dev-block-header">
            <h3 class="dev-grid-title" style="margin: 0;">
                PURCHASE HISTORY (READ-ONLY)
            </h3>
        </div>

        <% if (orders && orders.length > 0) { %>
            <div class="dev-table-wrapper">
                <table class="dev-table" id="tableBuyerOrders">
                    <thead>
                        <tr>
                            <th>VOYAGE / ORDER ID</th>
                            <th>DATE</th>
                            <th>CARGO MANIFEST ITEMS</th>
                            <th>TOTAL DOUBLOONS</th>
                            <th>ORDER STATUS</th>
                            <th>PAYMENT STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                            <tr>
                                <td>
                                    <span class="dev-table-cell-mono" style="color: var(--dev-brass-bright); font-weight: 700;"><%= order._id %></span>
                                </td>
                                <td>
                                    <%= new Date(order.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) %>
                                </td>
                                <td>
                                    <% if (order.items && order.items.length > 0) { %>
                                        <div style="display: flex; flex-direction: column; gap: 4px;">
                                            <% order.items.forEach(item => { %>
                                                <div style="font-size: 0.82rem;">
                                                    <span class="dev-table-cell-bold"><%= item.name %></span>
                                                    <span style="color: var(--dev-muted);"> &times; <%= item.quantity %></span>
                                                    <span style="color: var(--dev-brass-bright);">(<%= item.lineTotal || (item.price * item.quantity) %> Doubloons)</span>
                                                </div>
                                            <% }); %>
                                        </div>
                                    <% } else { %>
                                        <span style="color: var(--dev-muted);">No recorded items</span>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="dev-table-cell-bold" style="color: var(--dev-gold-bright); font-size: 0.92rem;"><%= order.totalDoubloons || order.subtotal || 0 %> Doubloons</span>
                                </td>
                                <td>
                                    <% if (order.status === 'delivered') { %>
                                        <span class="dev-status-tag tag-delivered">Delivered</span>
                                    <% } else if (order.status === 'processing') { %>
                                        <span class="dev-status-tag tag-pending">processing</span>
                                    <% } else if (order.status === 'cancelled') { %>
                                        <span class="dev-status-tag tag-rejected">Cancelled</span>
                                    <% } else { %>
                                        <span class="dev-status-tag"><%= order.status || 'Pending' %></span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (order.paymentStatus === 'paid') { %>
                                        <span class="dev-status-tag tag-approved">paid</span>
                                    <% } else if (order.paymentStatus === 'failed') { %>
                                        <span class="dev-status-tag tag-rejected">Failed</span>
                                    <% } else { %>
                                        <span class="dev-status-tag"><%= order.paymentStatus || 'Unpaid' %></span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="dev-empty-state">
                <span class="dev-empty-title">No Recorded Purchases</span>
                <p class="dev-empty-desc">This explorer has not yet concluded any trade voyages or orders across the archipelago.</p>
            </div>
        <% } %>

    </div>

</body>

</html>
