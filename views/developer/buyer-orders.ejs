<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page_title || "PIRATE-CIV // BUYER ORDERS" %></title>

    <!-- Google Fonts: Cinzel & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Developer Realm Stylesheet -->
    <link rel="stylesheet" href="/css/developer.css?v=dev_realm_v1">
</head>

<body class="dev-body">

    <div class="dev-container">

        <!-- ===================================================================
             TOP COMMAND BAR
             =================================================================== -->
        <header class="dev-topbar" role="banner">
            <div class="dev-branding">
                <span class="dev-realm-tag">PIRATE-CIV // SOVEREIGN ARCHITECT</span>
                <h1 class="dev-title-main">DEVELOPER REALM</h1>
            </div>

            <div class="dev-actions">
                <div class="dev-status-pill" title="Security Perimeter Active">
                    <span class="dev-status-indicator"></span>
                    <span>REALM SECURED // AUTHENTICATED</span>
                </div>

                <a href="/home" class="dev-btn" id="btnReturnSeaChart">
                    <span>RETURN TO SEA CHART</span>
                </a>

                <a href="/logout" class="dev-btn dev-btn-disconnect" id="btnDevDisconnect">
                    <span>DISCONNECT</span>
                </a>
            </div>
        </header>

        <!-- ===================================================================
             REALM NAVIGATION
             =================================================================== -->
        <nav class="dev-subnav" aria-label="Developer Navigation">
            <a href="/developer/dashboard" class="dev-nav-item">
                <span>OVERVIEW</span>
            </a>
            <a href="/developer/sellers/applications" class="dev-nav-item">
                <span>SELLER APPLICATIONS</span>
                <% if (typeof pendingSellersCount !== 'undefined' && pendingSellersCount > 0) { %>
                    <span class="dev-nav-badge-pending"><%= pendingSellersCount %></span>
                <% } %>
            </a>
            <a href="/developer/people" class="dev-nav-item active">
                <span>PEOPLE</span>
            </a>
        </nav>

        <!-- ===================================================================
             BREADCRUMB / BACK LINK
             =================================================================== -->
        <div class="dev-breadcrumb">
            <a href="/developer/people" class="dev-breadcrumb-link">&larr; BACK TO PEOPLE REGISTRY</a>
        </div>

        <!-- ===================================================================
             BUYER PROFILE OVERVIEW CARD
             =================================================================== -->
        <section class="dev-profile-banner">
            <div class="dev-profile-header">
                <div>
                    <span class="dev-hero-kicker">BUYER PURCHASE LEDGER</span>
                    <h2 class="dev-section-title"><%= buyer.name %></h2>
                    <p class="dev-section-desc">
                        Account: <strong><%= buyer.email %></strong> &bull; Home Island: <strong><%= buyer.homeIsland || "Astrolabe" %></strong> &bull; Registered: <strong><%= new Date(buyer.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) %></strong>
                    </p>
                </div>
                <div class="dev-profile-meta">
                    <span class="dev-count-tag" style="font-size: 0.9rem;"><%= orders ? orders.length : 0 %> Orders Recorded</span>
                </div>
            </div>
        </section>

        <!-- ===================================================================
             ORDER HISTORY TABLE (READ-ONLY)
             =================================================================== -->
        <div class="dev-block-header">
            <h3 class="dev-grid-title" style="margin: 0;">
                PURCHASE HISTORY (READ-ONLY)
            </h3>
        </div>

        <% if (orders && orders.length > 0) { %>
            <div class="dev-table-wrapper">
                <table class="dev-table" id="tableBuyerOrders">
                    <thead>
                        <tr>
                            <th>ORDER ID</th>
                            <th>DATE</th>
                            <th>ITEMS PURCHASED</th>
                            <th>QTY</th>
                            <th>TOTAL</th>
                            <th>ORDER STATUS</th>
                            <th>PAYMENT STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                            <% const totalQty = Array.isArray(order.items) ? order.items.reduce((sum, item) => sum + (item.quantity || 1), 0) : 0; %>
                            <tr>
                                <td>
                                    <span class="dev-table-cell-mono" style="font-weight: 600; color: var(--dev-gold-bright);"><%= order._id %></span>
                                </td>
                                <td><%= new Date(order.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) %></td>
                                <td>
                                    <% if (Array.isArray(order.items) && order.items.length > 0) { %>
                                        <div style="display: flex; flex-direction: column; gap: 4px;">
                                            <% order.items.forEach(item => { %>
                                                <div style="font-size: 0.8rem;">
                                                    <span style="color: var(--dev-parchment); font-weight: 500;"><%= item.name %></span>
                                                    <span style="color: var(--dev-muted);"> &times; <%= item.quantity %> (<%= item.price %> Dbl)</span>
                                                </div>
                                            <% }); %>
                                        </div>
                                    <% } else { %>
                                        <span style="color: var(--dev-muted);">No items recorded</span>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="dev-table-cell-mono"><%= totalQty %></span>
                                </td>
                                <td>
                                    <span class="dev-table-cell-brass"><%= order.totalDoubloons || order.subtotal || 0 %> Doubloons</span>
                                </td>
                                <td>
                                    <span class="dev-status-tag tag-<%= order.status || 'pending' %>"><%= order.status || 'pending' %></span>
                                </td>
                                <td>
                                    <span class="dev-status-tag tag-<%= order.paymentStatus || 'pending' %>"><%= order.paymentStatus || 'pending' %></span>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="dev-empty-state">
                <span class="dev-empty-title">No Purchases Recorded</span>
                <p class="dev-empty-desc">This buyer has not completed any voyages or purchases in the marketplace yet.</p>
            </div>
        <% } %>

    </div>

</body>

</html>
