<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page_title || "Kraken's Vault | Rishi's Web" %></title>

    <!-- Google Fonts: Cinzel & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Base Pirate Styles & Dedicated Island Store Styles -->
    <link rel="stylesheet" href="/css/style.css?v=p3_corsair_v1">
    <link rel="stylesheet" href="/css/island-store.css?v=kraken_v1">
</head>

<body class="island-store-body theme-kraken">

    <!-- Fixed Atmospheric Backdrop (Kraken Abyssal Citadel Artwork) -->
    <div class="store-backdrop">
        <img src="/images/kraken-bg.jpg" alt="Kraken's Vault Abyssal Citadel" class="store-bg-img" style="opacity: 0.82; object-position: center 30%;">
        <div class="store-vignette" style="background: radial-gradient(circle at 65% 45%, transparent 25%, rgba(2, 8, 12, 0.6) 65%, rgba(1, 4, 8, 0.94) 100%), linear-gradient(180deg, rgba(2, 6, 10, 0.5) 0%, transparent 25%, rgba(2, 6, 10, 0.75) 85%, #020406 100%);"></div>
    </div>

    <!-- Adjusted Reusable Navbar (Non-colliding, Flow-Anchored) -->
    <%- include("partials/header") %>

    <!-- Master Store Stage -->
    <main class="island-store-wrapper">

        <!-- Quick Logbook & Archipelago Navigation Bar (Matches Reference Image) -->
        <nav class="store-quick-nav-bar">
            <span class="quick-nav-label">📜 LOGBOOK:</span>
            <a href="/#sea-chart-section" class="quick-nav-btn">🏰 GRAND BAZAAR</a>
            <a href="/?branch=apparel#sea-chart-section" class="quick-nav-btn">⚔️ PORT OF CORSAIR APPAREL</a>
            <a href="/?branch=relics#sea-chart-section" class="quick-nav-btn btn-return-capital">🔄 RETURN TO CAPITAL</a>
        </nav>

        <!-- Top Bar: Center Title & Right Header Controls -->
        <header class="store-top-bar">
            <div class="store-header-center">
                <span class="store-badge-embargo">CURSED RELICS</span>
                <h1 class="store-main-title">
                    <span class="store-title-icon">🔱</span>
                    <span><%= island.name %></span>
                </h1>
                <p class="store-subtitle">Accessories from the depths</p>
            </div>

            <div class="store-header-controls">
                <div class="doubloons-pill">
                    <span class="coin-icon">🪙</span>
                    <span>1,240 Doubloons</span>
                </div>

                <button id="btnOpenCart" class="btn-store-cart">
                    <span>🛒 CART</span>
                    <span id="cartCountBadge">(0)</span>
                </button>

                <a href="/?branch=relics#sea-chart-section" class="btn-store-close" title="Return to Sea Chart">
                    &times;
                </a>
            </div>
        </header>

        <!-- Body Grid: Sidebar + Store Grid Area -->
        <div class="store-body-grid">

            <!-- Left Sidebar Category Filter (Matches Reference Image) -->
            <aside class="store-sidebar">
                <ul class="sidebar-nav-list">
                    <li class="sidebar-nav-item active" data-category="all">
                        <span class="nav-icon">✦</span>
                        <span>All Items</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="amulets">
                        <span class="nav-icon">📿</span>
                        <span>Amulets</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="rings">
                        <span class="nav-icon">💍</span>
                        <span>Rings</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="charms">
                        <span class="nav-icon">🦷</span>
                        <span>Charms</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="relics">
                        <span class="nav-icon">❄️</span>
                        <span>Relics</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="trinkets">
                        <span class="nav-icon">☸️</span>
                        <span>Trinkets</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="artifacts">
                        <span class="nav-icon">🔮</span>
                        <span>Artifacts</span>
                    </li>
                </ul>

                <!-- Carved Kraken Crest & Motto (Matches Reference Image) -->
                <div class="sidebar-kraken-crest">
                    <span class="kraken-crest-icon">🐙</span>
                    <p class="kraken-quote">SOME TREASURES SHOULD REMAIN LOST...</p>
                </div>
            </aside>

            <!-- Main Store Area -->
            <section class="store-main-area">

                <!-- Search & Sort Bar -->
                <div class="store-filter-bar">
                    <div class="search-input-wrapper">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="storeSearchInput" class="store-search-input" placeholder="Search accessories, relics, trinkets...">
                    </div>

                    <select id="storeSortSelect" class="store-sort-select">
                        <option value="default">Sort by: Default ▾</option>
                        <option value="price-low">Price: Low to High</option>
                        <option value="price-high">Price: High to Low</option>
                        <option value="name">Name: A-Z</option>
                    </select>
                </div>

                <!-- Store Items Grid -->
                <div id="storeItemsGrid" class="store-items-grid">
                    <% if (island.products && island.products.length > 0) { %>
                        <% island.products.forEach(function(p) { %>
                            <article class="store-item-card"
                                     data-id="<%= p.id %>"
                                     data-name="<%= p.name %>"
                                     data-price="<%= p.price %>"
                                     data-category="<%= p.category || 'all' %>"
                                     data-desc="<%= p.desc %>">
                                
                                <div class="card-header-bar">
                                    <span class="tag-new">NEW</span>
                                    <button class="btn-wishlist" data-id="<%= p.id %>" data-name="<%= p.name %>" title="Add to Wishlist">♡</button>
                                </div>

                                <a href="/product/<%= p.id %>" class="item-asset-link" title="Inspect <%= p.name %>">
                                    <div class="item-asset-box">
                                        <div class="item-asset-glow"></div>
                                        <img src="<%= p.image %>" alt="<%= p.name %>" class="item-asset-img" onerror="this.onerror=null; this.src='/images/items/default-relic.png';">
                                    </div>
                                </a>

                                <h3 class="item-title">
                                    <a href="/product/<%= p.id %>" class="item-title-link" title="Inspect <%= p.name %>"><%= p.name %></a>
                                </h3>
                                <p class="item-desc"><%= p.desc %></p>

                                <div class="item-meta-row">
                                    <span class="item-price">🪙 <%= p.price %> Doubloons</span>
                                    <span class="item-rating"><%= p.rating || '★★★★★' %></span>
                                </div>

                                <div class="card-action-row">
                                    <button class="btn-add-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>">
                                        <span>🛒 ADD TO CART</span>
                                    </button>
                                    <a href="/product/<%= p.id %>" class="btn-card-details" title="View details of <%= p.name %>">
                                        <span>🔍 DETAILS</span>
                                    </a>
                                </div>
                            </article>
                        <% }); %>
                    <% } else { %>
                        <div class="store-empty-state">
                            <span class="store-empty-icon">⚓</span>
                            <h3 class="store-empty-title">No Trade Cargo Available</h3>
                            <p class="store-empty-desc">The merchant vaults of <%= island.name %> are currently barren. No goods are chartered for trading at this hour.</p>
                        </div>
                    <% } %>
                </div>

            </section>

        </div>

    </main>

    <!-- Cargo Cart Drawer -->
    <aside id="storeCartDrawer" class="store-cart-drawer">
        <div class="cart-drawer-header">
            <h3 class="cart-drawer-title">⚓ Cargo Hold</h3>
            <button id="btnCloseCart" class="btn-cart-close">&times;</button>
        </div>
        <div id="cartDrawerItems" class="cart-drawer-items"></div>
        <div class="cart-drawer-footer">
            <div class="cart-total-row">
                <span>Total Cargo:</span>
                <span id="cartDrawerTotal">🪙 0 Doubloons</span>
            </div>
            <button id="btnCheckoutCargo" class="btn-checkout-cargo">
                Secure Cargo (Checkout)
            </button>
        </div>
    </aside>

    <!-- Unified Island Store JS Engine -->
    <script src="/js/island-store.js?v=kraken_v1"></script>

</body>

</html>
