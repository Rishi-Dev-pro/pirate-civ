    .navbar .nav-links.nav-links-open a.nav-mobile-only {
        display: block !important;
    }
    .navbar .nav-links a {
        font-size: 11px !important;
        padding: 8px 10px;
        border-radius: 4px;
    }
    .navbar .nav-links a:hover,
    .navbar .nav-links a:focus-visible {
        background: rgba(198, 159, 88, 0.12);
