<%
    const activeRoute = (typeof currentPath !== 'undefined' && currentPath) ? currentPath : '';
    const currentUser = (typeof user !== 'undefined' && user) ? user : null;
    const userRole = currentUser ? currentUser.role : 'guest';

    function getActiveNavKey(route) {
        if (!route) return '';
        if (route === '/' || route === '') return 'gateway';
        if (route === '/home' || route.startsWith('/island') || route.startsWith('/product') ||
            route === '/astrolabe' || route === '/chronos' || route === '/kraken-vault' ||
            route === '/cutlass-cove' || route === '/velvet-isle' || route === '/booty-cay') {
            return 'seachart';
        }
        if (route.startsWith('/cart') || route.startsWith('/checkout')) return 'cart';
        if (route.startsWith('/orders')) return 'orders';
        if (route.startsWith('/favorites')) return 'favorites';
        if (route.startsWith('/users') || route.startsWith('/explorers')) return 'explorers';
        if (route === '/profile') return 'profile';
        if (route === '/seller/dashboard' || route === '/seller/portal' || route === '/seller') return 'seller_deck';
        if (route.startsWith('/seller/products')) return 'seller_products';
        if (route.startsWith('/seller/orders')) return 'seller_orders';
        if (route.startsWith('/seller/profile')) return 'seller_profile';
        if (route.startsWith('/about')) return 'about';
        if (route.startsWith('/contact')) return 'contact';
        if (route.startsWith('/login') || route.startsWith('/buyer/login') || route.startsWith('/seller/login')) return 'login';
        if (route.startsWith('/register') || route.startsWith('/buyer/register') || route.startsWith('/seller/register')) return 'register';
        return '';
    }

    const currentNavKey = getActiveNavKey(activeRoute);
%>

<nav class="navbar" role="navigation" aria-label="Main Navigation">

    <!-- Brand Logo with Role-Aware Destination -->
    <a href="<%= currentUser ? (userRole === 'seller' ? '/seller/dashboard' : '/home') : '/' %>" class="logo nav-brand" id="navBrandLogo" title="Pirate-Civ Sovereign Seas">
        <span class="logo-symbol" aria-hidden="true"><%= userRole === 'seller' ? '⚓' : '🏴‍☠️' %></span>
        <span class="logo-text">PIRATE-CIV</span>
    </a>

    <!-- Mobile Navigation Toggle -->
    <button class="nav-toggle" id="navToggleBtn" type="button" aria-expanded="false" aria-controls="navLinksMenu" aria-label="Toggle Navigation Menu">
        <span class="toggle-icon">☰</span>
    </button>

    <!-- Role-Aware Navigation Links -->
    <div class="nav-links" id="navLinksMenu">

        <% if (!currentUser) { %>
            <!-- ================= GUEST NAVIGATION ================= -->
            <a href="/" class="nav-link <%= currentNavKey === 'gateway' ? 'active' : '' %>" id="navGateway" <%- currentNavKey === 'gateway' ? 'aria-current="page"' : '' %>>
                The Sea Awaits
            </a>

            <a href="/about" class="nav-link <%= currentNavKey === 'about' ? 'active' : '' %>" id="navAbout" <%- currentNavKey === 'about' ? 'aria-current="page"' : '' %>>
                Guild Lore
            </a>

            <a href="/contact" class="nav-link <%= currentNavKey === 'contact' ? 'active' : '' %>" id="navContact" <%- currentNavKey === 'contact' ? 'aria-current="page"' : '' %>>
                Dispatch
            </a>

            <a href="/buyer/login" class="nav-link nav-btn-signin <%= currentNavKey === 'login' ? 'active' : '' %>" id="navLogin" <%- currentNavKey === 'login' ? 'aria-current="page"' : '' %>>
                Sign In
            </a>

            <a href="/buyer/register" class="nav-link nav-btn-register <%= currentNavKey === 'register' ? 'active' : '' %>" id="navRegister" <%- currentNavKey === 'register' ? 'aria-current="page"' : '' %>>
                Join Crew
            </a>

        <% } else if (userRole === 'buyer') { %>
            <!-- ================= BUYER NAVIGATION (STREAMLINED) ================= -->
            <a href="/home" class="nav-link <%= currentNavKey === 'seachart' ? 'active' : '' %>" id="navSeaChart" <%- currentNavKey === 'seachart' ? 'aria-current="page"' : '' %>>
                🗺️ Sea Chart
            </a>

            <a href="/cart" class="nav-link nav-cart <%= currentNavKey === 'cart' ? 'active' : '' %>" id="navCargoHold" <%- currentNavKey === 'cart' ? 'aria-current="page"' : '' %>>
                📦 Cargo Hold<span class="nav-cargo-count" id="navCargoCount"><%= (typeof cart !== 'undefined' && cart && cart.itemCount > 0) ? ` (${cart.itemCount})` : '' %></span>
            </a>

            <a href="/orders" class="nav-link nav-buyer-orders <%= currentNavKey === 'orders' ? 'active' : '' %>" id="navBuyerOrders" <%- currentNavKey === 'orders' ? 'aria-current="page"' : '' %>>
                ⚓ My Voyages
            </a>

            <!-- Single Captain Identity Control (No duplicate Profile in top bar) -->
            <%
                const rawBuyerName = (currentUser && currentUser.name) ? currentUser.name.trim() : 'Captain';
                const cleanCaptainName = /^captain\s+/i.test(rawBuyerName) ? rawBuyerName : ('Captain ' + rawBuyerName);
            %>
            <a href="/profile" class="nav-user-badge" id="navUserBadge" title="<%= cleanCaptainName %>" aria-label="Chartered Captain Profile: <%= cleanCaptainName %>" style="text-decoration: none;">
                <span class="badge-icon">⚓</span> <span class="nav-user-name"><%= cleanCaptainName %></span>
            </a>

            <a href="/logout" class="nav-link logout-btn" id="navLogout">
                Logout
            </a>
        <% } else if (userRole === 'seller') { %>
            <!-- ================= SELLER NAVIGATION (UNIFIED & STREAMLINED) ================= -->
            <a href="/home" class="nav-link <%= currentNavKey === 'seachart' ? 'active' : '' %>" id="navSeaChart" <%- currentNavKey === 'seachart' ? 'aria-current="page"' : '' %>>
                🗺️ Sea Chart
            </a>

            <a href="/seller/dashboard" class="nav-link nav-seller-deck <%= currentNavKey === 'seller_deck' ? 'active' : '' %>" id="navSellerDeck" <%- currentNavKey === 'seller_deck' ? 'aria-current="page"' : '' %>>
                ⚓ Seller Deck
            </a>

            <a href="/seller/orders" class="nav-link nav-seller-orders <%= currentNavKey === 'seller_orders' ? 'active' : '' %>" id="navSellerOrders" <%- currentNavKey === 'seller_orders' ? 'aria-current="page"' : '' %>>
                📜 Orders
            </a>

            <!-- Mobile-only secondary drawer links -->
            <a href="/seller/products" class="nav-link nav-seller-products nav-mobile-only <%= currentNavKey === 'seller_products' ? 'active' : '' %>" id="navSellerProducts" <%- currentNavKey === 'seller_products' ? 'aria-current="page"' : '' %>>
                📦 Products / Forge Cargo
            </a>

            <a href="/seller/profile" class="nav-link nav-seller-profile nav-mobile-only <%= currentNavKey === 'seller_profile' ? 'active' : '' %>" id="navSellerProfile" <%- currentNavKey === 'seller_profile' ? 'aria-current="page"' : '' %>>
                ⚙️ Seller Profile
            </a>

            <a href="/about" class="nav-link nav-mobile-only <%= currentNavKey === 'about' ? 'active' : '' %>" id="navAbout" <%- currentNavKey === 'about' ? 'aria-current="page"' : '' %>>
                📜 Guild Lore
            </a>

            <%
                const rawSellerDisplayName = (currentUser && (currentUser.storeName || currentUser.name)) ? (currentUser.storeName || currentUser.name).trim() : 'Merchant';
                const fullSellerLabel = (currentUser && currentUser.storeName && currentUser.name && currentUser.storeName !== currentUser.name)
                    ? `${currentUser.storeName} — Captain ${currentUser.name.replace(/^captain\s+/i, '')}`
                    : rawSellerDisplayName;
            %>
            <a href="/seller/profile" class="nav-user-badge" id="navUserBadge" title="<%= fullSellerLabel %>" aria-label="Chartered Merchant Profile: <%= fullSellerLabel %>" style="text-decoration: none;">
                <span class="badge-icon">⚓</span> <span class="nav-user-name"><%= rawSellerDisplayName %></span>
            </a>

            <a href="/logout" class="nav-link logout-btn" id="navLogout">
                Logout
            </a>

        <% } else if (userRole === 'admin') { %>
            <!-- ================= ADMIN NAVIGATION ================= -->
            <a href="/home" class="nav-link <%= currentNavKey === 'seachart' ? 'active' : '' %>" id="navSeaChart" <%- currentNavKey === 'seachart' ? 'aria-current="page"' : '' %>>
                🗺️ Sea Chart
            </a>

            <a href="/explorers" class="nav-link nav-users <%= currentNavKey === 'explorers' ? 'active' : '' %>" id="navUsers" <%- currentNavKey === 'explorers' ? 'aria-current="page"' : '' %>>
                👥 Explorers
            </a>

            <a href="/about" class="nav-link <%= currentNavKey === 'about' ? 'active' : '' %>" id="navAbout" <%- currentNavKey === 'about' ? 'aria-current="page"' : '' %>>
                Guild Lore
            </a>

            <a href="/contact" class="nav-link <%= currentNavKey === 'contact' ? 'active' : '' %>" id="navContact" <%- currentNavKey === 'contact' ? 'aria-current="page"' : '' %>>
                Dispatch
            </a>

            <span class="nav-user-badge" id="navUserBadge" title="Admiralty Authority">
                <span class="badge-icon">🛡️</span> Admin <%= currentUser.name %>
            </span>

            <a href="/logout" class="nav-link logout-btn" id="navLogout">
                Logout
            </a>
        <% } %>

    </div>

</nav>

<% if (currentUser && userRole === 'buyer') { %>
<!-- ==========================================
     CAPTAIN'S LOG / CHART — COMPACT SIDE PANEL
========================================== -->
<aside class="captain-panel" id="captainSidePanel" aria-label="Captain's Navigation Chart">
    <!-- Collapse / Expand Toggle Button -->
    <button type="button" class="captain-panel-toggle" id="captainPanelToggle" aria-expanded="true" aria-controls="captainPanelBody" title="Toggle Captain's Chart">
        <span class="panel-toggle-icon" aria-hidden="true">⚓</span>
        <span class="panel-toggle-text">Captain's Log</span>
        <span class="panel-collapse-arrow" id="panelCollapseArrow" aria-hidden="true">‹</span>
    </button>

    <div class="captain-panel-body" id="captainPanelBody">
        <div class="captain-panel-header">
            <span class="panel-ornament" aria-hidden="true">✦</span>
            <span class="panel-title">CAPTAIN'S CHART</span>
            <span class="panel-ornament" aria-hidden="true">✦</span>
        </div>

        <nav class="captain-panel-nav" aria-label="Captain Log Secondary Navigation">
            <a href="/favorites" class="captain-panel-link <%= currentNavKey === 'favorites' ? 'active' : '' %>" id="sideNavFavorites" <%- currentNavKey === 'favorites' ? 'aria-current="page"' : '' %>>
                <span class="panel-link-icon" aria-hidden="true">❤️</span>
                <span class="panel-link-label">Favorites</span>
            </a>

            <a href="/explorers" class="captain-panel-link <%= currentNavKey === 'explorers' ? 'active' : '' %>" id="sideNavExplorers" <%- currentNavKey === 'explorers' ? 'aria-current="page"' : '' %>>
                <span class="panel-link-icon" aria-hidden="true">👥</span>
                <span class="panel-link-label">Explorers</span>
            </a>

            <a href="/about" class="captain-panel-link <%= currentNavKey === 'about' ? 'active' : '' %>" id="sideNavAbout" <%- currentNavKey === 'about' ? 'aria-current="page"' : '' %>>
                <span class="panel-link-icon" aria-hidden="true">📜</span>
                <span class="panel-link-label">Guild Lore</span>
            </a>

            <a href="/profile" class="captain-panel-link <%= currentNavKey === 'profile' ? 'active' : '' %>" id="sideNavProfile" <%- currentNavKey === 'profile' ? 'aria-current="page"' : '' %>>
                <span class="panel-link-icon" aria-hidden="true">👤</span>
                <span class="panel-link-label">Profile</span>
            </a>
        </nav>

        <div class="captain-panel-footer">
            <span class="panel-motto">Sovereign Seas</span>
        </div>
    </div>
</aside>
<% } %>

<style>
