<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= page_title %></title>

    <link rel="stylesheet" href="/css/about.css">

</head>


<body>


    <!-- Background Video -->

    <video autoplay muted loop playsinline id="bg-video">

        <source
            src="/videos/about.mp4"
            type="video/mp4"
        >

    </video>


    <div class="overlay"></div>


    <!-- Reusable Navbar -->

    <%- include("partials/header") %>


    <!-- Hero -->

    <section class="hero">

        <div class="hero-text">

            <h1>
                About
                <span>Pirate-Civ</span>
            </h1>

            <p>
                Pirate-Civ is a dark-fantasy nautical e-commerce realm. Navigate uncharted
                waters across six storied islands, discover rare maritime artifacts, and trade with
                legendary merchant armators beneath skies lit by fire and brimstone.
            </p>

        </div>

    </section>


    <!-- Features -->

    <section class="cards">

        <div class="card">

            <h3>⚓ The Archipelago</h3>

            <p>
                From the volcanic armories of Ignis to the gilded vaults of Golden Haven,
                each island harbors specialized craft, rare relics, and distinct guilds of commerce.
            </p>

        </div>


        <div class="card">

            <h3>⚔ Merchant Armators</h3>

            <p>
                Independent corsairs and seafaring merchants anchor in our Grand Bazaar,
                offering curated expeditions, nautical instruments, and legendary goods.
            </p>

        </div>


        <div class="card">

            <h3>🪙 Doubloon Economy</h3>

            <p>
                A unified maritime trading network backed by cryptographic security,
                honored across all ports, trading posts, and contested sovereign waters.
            </p>

        </div>

    </section>

     <!-- Footer -->

    <%- include("partials/footer") %>


</body>

</html>