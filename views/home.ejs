<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= page_title || "Rishi's Web - Home" %></title>

    <!-- Google Fonts: Cinzel + Inter (Same as Login & Users) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet"
    >

    <!-- Home Page CSS -->
    <link rel="stylesheet" href="/css/style.css?v=p3_corsair_v1">

</head>


<body>

    <!-- ==========================================
         BACKGROUND & PIRATE ATMOSPHERE
    =========================================== -->

    <div class="page-background">

        <!-- Nautical Grid Map Backdrop Layer -->
        <div class="grid-map-backdrop">
            <img
                src="/images/nautical-grid.png"
                alt="Nautical Chart Grid Map"
                class="grid-map-img"
            >
            <div class="grid-map-vignette"></div>
        </div>

        <!-- Atmospheric Smoke -->
        <div class="smoke smoke-one"></div>
        <div class="smoke smoke-two"></div>

        <!-- Animated Fire Embers -->
        <div class="embers">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
        </div>

    </div>


    <!-- ==========================================
         CORNER DECORATIONS (MATCHING LOGIN)
    =========================================== -->

    <div class="corner-compass top-left">✦</div>
    <div class="corner-compass top-right">⚓</div>


    <!-- ==========================================
         NAVBAR (EXACT SAME AS USERS NAVBAR)
    =========================================== -->

    <%- include("partials/header") %>


    <!-- ==========================================
         MAIN CONTENT
    =========================================== -->

    <main class="home-container">

        <!-- ===========================
             Hero Section
        ============================ -->

        <section class="hero">

            <div class="hero-ornament">
                <span>✦</span>
                <span class="hero-subtitle-tag">CHART THE UNKNOWN WATERS</span>
                <span>✦</span>
            </div>

            <div class="hero-text">

                <h1>
                    WELCOME TO
                    <span>RISHI'S REALM</span>
                </h1>

                <p>
                    An ancient maritime voyage powered by modern craft. Inspect uncharted
                    archipelagos, plotted coordinates, and pirate strongholds preserved upon
                    the sacred imperial sea chart.
                </p>

                <div class="hero-actions">
                    <a href="#sea-chart-section" class="btn-pirate">
                        Inspect Sea Chart 🗺️
                    </a>
                    <a href="/users" class="btn-pirate-outline">
                        View Explorers ⚓
                    </a>
                </div>

            </div>

        </section>


        <!-- ===========================
             Feature Cards
        ============================ -->

        <section class="cards">

            <div class="card">
                <div class="card-corner corner-tl"></div>
                <div class="card-corner corner-br"></div>
                <div class="card-icon">⚡</div>
                <h3>Swift Navigation</h3>
                <p>
                    Engineered with Node.js & Express 5 for lightning-fast passage across stormy digital seas.
                </p>
            </div>

            <div class="card">
                <div class="card-corner corner-tl"></div>
                <div class="card-corner corner-br"></div>
                <div class="card-icon">🗺️</div>
                <h3>Cartographer's Craft</h3>
                <p>
                    Hand-crafted dark fantasy interfaces inspired by 17th century nautical charts and burnt parchment.
                </p>
            </div>

            <div class="card">
                <div class="card-corner corner-tl"></div>
                <div class="card-corner corner-br"></div>
                <div class="card-icon">⚓</div>
                <h3>Dynamic Ledger</h3>
                <p>
                    Dynamic server-rendered EJS templates coupled with persistent Mongo records and session security.
                </p>
            </div>

        </section>


        <!-- =================================================
             PIRATE NAUTICAL CHART SECTION (REPLACES TABLE)
        ================================================== -->

        <section id="sea-chart-section" class="chart-section">

