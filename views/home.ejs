    <!-- ==========================================
         MIND MAP & LANTERN ENGINE SCRIPTS
    =========================================== -->

    <script src="/js/mindmap.js?v=p3_corsair_v10"></script>

    <script>

        const container = document.getElementById("chartContainer");
        const lantern = document.getElementById("lanternLight");
        const coordDisplay = document.getElementById("coordDisplay");

        if (container && lantern) {

            container.addEventListener("mousemove", (e) => {

                const rect = container.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                lantern.style.opacity = "1";
                lantern.style.left = `${x}px`;
                lantern.style.top = `${y}px`;

                // Calculate faux nautical coordinates based on grid position
                const normX = Math.round((x / rect.width) * 60);
                const normY = Math.round((y / rect.height) * 40);

                const lat = `${normY}°${(normX * 3) % 60}'N`;
                const lon = `${normX}°${(normY * 4) % 60}'W`;

                if (coordDisplay) {
                    coordDisplay.textContent = `${lat}, ${lon}`;
                }

            });

            container.addEventListener("mouseleave", () => {
                lantern.style.opacity = "0";
                if (coordDisplay) {
                    coordDisplay.textContent = "18°42'N, 64°31'W";
                }
            });

        }

    </script>

</body>

