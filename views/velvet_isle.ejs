<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page_title || "Velvet Isle | Rishi's Web" %></title>

    <!-- Google Fonts: Cinzel & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Base Pirate Styles & Dedicated Island Store Styles -->
    <link rel="stylesheet" href="/css/style.css?v=p3_corsair_v1">
    <link rel="stylesheet" href="/css/island-store.css?v=velvet_v1">
</head>

<body class="island-store-body theme-velvet">

    <!-- Fixed Atmospheric Backdrop (Velvet Isle Coastal Resort Lagoon & Balcony Artwork) -->
    <div class="store-backdrop">
        <img src="/images/velvet-bg.jpg" alt="Velvet Isle Serene Coastal Resort" class="store-bg-img" style="opacity: 0.90; object-position: center 30%;">
        <div class="store-vignette" style="background: radial-gradient(circle at 75% 45%, transparent 22%, rgba(6, 14, 16, 0.55) 65%, rgba(2, 6, 8, 0.92) 100%), linear-gradient(180deg, rgba(4, 10, 12, 0.45) 0%, transparent 22%, rgba(4, 10, 12, 0.7) 85%, #020608 100%);"></div>
    </div>

    <!-- Adjusted Reusable Navbar (Non-colliding, Flow-Anchored) -->
    <%- include("partials/header") %>

    <!-- Master Store Stage -->
    <main class="island-store-wrapper">

        <!-- Top Bar: Center Title & Right Header Controls -->
        <header class="store-top-bar">
            <div class="store-header-center">
                <span class="store-badge-embargo">ELEVATE EVERY SPACE</span>
                <h1 class="store-main-title">
                    <span class="store-title-icon">🧭</span>
                    <span><%= island.name %></span>
                </h1>
                <div class="store-subheading"><%= island.title || "HOME & LIVING" %></div>
                <p class="store-subtitle"><%= island.desc || "Timeless living for modern explorers. Discover decor, furniture, textiles and more from the serene shores of Velvet Isle." %></p>
            </div>

            <div class="store-header-controls">
                <div class="doubloons-pill">
                    <span class="coin-icon">🪙</span>
                    <span>1,240 Doubloons</span>
                </div>

                <button id="btnOpenCart" class="btn-store-cart">
                    <span>🛒 CART</span>
                    <span id="cartCountBadge">(0)</span>
                </button>

                <a href="/?branch=apparel#sea-chart-section" class="btn-store-close" title="Return to Sea Chart">
                    &times;
                </a>
            </div>
        </header>

        <!-- Body Grid: Sidebar + Store Grid Area -->
        <div class="store-body-grid">

            <!-- Left Sidebar Category Filter (Matches Reference Mockup) -->
            <aside class="store-sidebar">
                <ul class="sidebar-nav-list">
                    <li class="sidebar-nav-item active" data-category="all">
                        <span class="nav-icon">🏠</span>
                        <span>All Home & Living</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="furniture">
                        <span class="nav-icon">🪑</span>
                        <span>Furniture</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="decor">
                        <span class="nav-icon">🏺</span>
                        <span>Home Decor</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="lighting">
                        <span class="nav-icon">💡</span>
                        <span>Lighting</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="bedding">
                        <span class="nav-icon">🛏️</span>
                        <span>Bedding & Linen</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="dining">
                        <span class="nav-icon">🍽️</span>
                        <span>Kitchen & Dining</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="storage">
                        <span class="nav-icon">📦</span>
                        <span>Storage & Organization</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="rugs">
                        <span class="nav-icon">🧶</span>
                        <span>Rugs & Carpets</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="furnishings">
                        <span class="nav-icon">🪟</span>
                        <span>Curtains & Furnishings</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="plants">
                        <span class="nav-icon">🪴</span>
                        <span>Indoor Plants</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="art">
                        <span class="nav-icon">🖼️</span>
                        <span>Wall Art</span>
                    </li>
                    <li class="sidebar-nav-item" data-category="gift">
                        <span class="nav-icon">🎁</span>
                        <span>Gift Sets</span>
                    </li>
                </ul>

                <!-- Carved Motto Crest (Matches Reference Mockup) -->
                <div class="sidebar-velvet-crest">
                    <span class="velvet-crest-icon">🧭</span>
                    <div class="velvet-motto-lines">
                        <span>BEAUTIFUL SPACES</span>
                        <span>BRIGHTER DAYS</span>
                    </div>
                </div>
            </aside>

            <!-- Main Store Area -->
            <section class="store-main-area">

                <!-- Search & Sort Bar -->
                <div id="storeFilterBar" class="store-filter-bar">
                    <div class="search-input-wrapper">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="storeSearchInput" class="store-search-input" placeholder="Search products, styles, inspiration...">
                    </div>

                    <select id="storeSortSelect" class="store-sort-select">
                        <option value="default">Sort by: Featured ▾</option>
                        <option value="price-low">Price: Low to High</option>
                        <option value="price-high">Price: High to Low</option>
                        <option value="name">Name: A-Z</option>
                    </select>
                </div>

                <!-- Store Items Grid (6 Cards in 2 Rows of 3) -->
                <div id="storeItemsGrid" class="store-items-grid">
                    <% island.products.forEach(function(p) { %>
                        <article class="store-item-card"
                                 data-id="<%= p.id %>"
                                 data-name="<%= p.name %>"
                                 data-price="<%= p.priceNum || p.price %>"
                                 data-category="<%= p.category || 'all' %>"
                                 data-desc="<%= p.desc || p.subTitle || '' %>">
                            
                            <div class="card-header-bar">
                                <span class="tag-new">NEW</span>
                                <button class="btn-wishlist" data-id="<%= p.id %>" data-name="<%= p.name %>" title="Add to Wishlist">♡</button>
                            </div>

                            <div class="item-asset-box">
                                <div class="item-asset-glow"></div>
                                <img src="<%= p.image %>" alt="<%= p.name %>" class="item-asset-img">
                            </div>

                            <h3 class="item-title"><%= p.name %></h3>
                            <p class="item-desc"><%= p.subTitle || p.desc %></p>

                            <div class="item-meta-row">
                                <span class="item-price">₹<%= p.price %></span>
                                <span class="item-rating"><%= p.rating || '★★★★★' %></span>
                            </div>

                            <button class="btn-add-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.priceNum || p.price %>">
                                <span>🛒 ADD TO CART</span>
                            </button>
                        </article>
                    <% }); %>
                </div>

                <!-- Velvet Bottom Bar (Matches Mockup Quotes) -->
                <div class="velvet-bottom-bar">
                    <div class="velvet-quote-left">
                        <span>More than a home — A State of Mind</span>
                        <span style="font-size: 1.1rem; color: #ffd57e;">✶</span>
                    </div>
                    <div class="velvet-quote-right">
                        <span>A HOME FOR EVERY JOURNEY</span>
                    </div>
                </div>

            </section>

        </div>

    </main>

    <!-- Cargo Cart Drawer -->
    <aside id="storeCartDrawer" class="store-cart-drawer">
        <div class="cart-drawer-header">
            <h3 class="cart-drawer-title">⚓ Cargo Hold</h3>
            <button id="btnCloseCart" class="btn-cart-close">&times;</button>
        </div>
        <div id="cartDrawerItems" class="cart-drawer-items"></div>
        <div class="cart-drawer-footer">
            <div class="cart-total-row">
                <span>Total Cargo:</span>
                <span id="cartDrawerTotal">🪙 0 Doubloons</span>
            </div>
            <button id="btnCheckoutCargo" class="btn-checkout-cargo">
                Secure Cargo (Checkout)
            </button>
        </div>
    </aside>

    <!-- Unified Island Store JS Engine -->
    <script src="/js/island-store.js?v=velvet_v1"></script>

</body>

</html>
