<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page_title || "Merchant Storefront | Pirate-Civ" %></title>

    <!-- Google Fonts: Cinzel & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Master & Dedicated Island Store Styles -->
    <link rel="stylesheet" href="/css/style.css?v=p3_corsair_v1">
    <link rel="stylesheet" href="/css/island-store.css?v=seller_store_v1">
</head>

<body class="island-store-body seller-discovery-body seller-storefront-body">

    <!-- Fixed Atmospheric Backdrop -->
    <div class="store-backdrop">
        <img src="<%= (island && island.image) ? island.image : '/images/astrolabe-bg.jpg' %>"
             alt="Archipelago Backdrop"
             class="store-bg-img"
             onerror="this.onerror=null; this.src='/images/astrolabe-bg.jpg';">
        <div class="store-vignette"></div>
    </div>

    <!-- Reusable Main Navigation Bar -->
    <%- include("partials/header") %>

    <!-- Master Seller Storefront Stage -->
    <main class="seller-discovery-wrapper seller-storefront-wrapper">

        <!-- Top Navigation Bar: Breadcrumbs & Header Actions -->
        <nav class="detail-nav-bar" aria-label="Breadcrumb Navigation">
            <div class="detail-breadcrumbs">
                <a href="/home" class="crumb-link">Sea Chart</a>
                <span class="crumb-separator">›</span>
                <span class="crumb-link">Merchant Guild</span>
                <span class="crumb-separator">›</span>
                <span class="crumb-current"><%= seller.storeName || seller.name %></span>
            </div>

            <div class="store-header-controls">
                <div class="doubloons-pill">
                    <span class="coin-icon">🪙</span>
                    <span>1,240 Doubloons</span>
                </div>

                <button id="btnOpenCart" class="btn-store-cart" title="Open Cargo Hold">
                    <span>🛒 CART</span>
                    <span id="cartCountBadge">(0)</span>
                </button>

                <a href="/home" class="btn-store-close" title="Return to Sea Chart">
                    &times;
                </a>
            </div>
        </nav>

        <!-- Master Merchant Identity Card -->
        <article class="seller-card-container">

            <!-- Hero Header: Avatar + Identity + Telemetry -->
            <header class="seller-hero">
                <div class="seller-avatar-frame">
                    <img src="<%= seller.avatar || '/images/avatars/default-pirate.png' %>"
                         alt="<%= seller.storeName || seller.name %>"
                         class="seller-large-avatar"
                         onerror="this.onerror=null; this.src='/images/avatars/default-pirate.png';">
                </div>

                <div class="seller-hero-info">
                    <span class="seller-badge-charter">⚓ CHARTERED GUILD MERCHANT</span>
                    <h1 class="seller-display-name"><%= seller.storeName || seller.name %></h1>
                    <% if (seller.storeName && seller.name && seller.name !== seller.storeName) { %>
                        <span class="seller-captain-alias">Captain / Guildmaster: <%= seller.name %></span>
                    <% } %>
                    <div class="seller-meta-pills">
                        <span class="seller-stat-pill">
                            <% if (seller.homeIsland) { %>
                                <a href="/island/<%= seller.homeIsland %>" class="home-harbor-link" title="Sail to Home Harbor">
                                    🏝️ Home Harbor: <%= island ? island.name : seller.homeIsland %>
                                </a>
                            <% } else { %>
                                🏝️ Home Harbor: Archipelago Waters
                            <% } %>
                        </span>
                        <span class="seller-stat-pill">
                            📦 <%= seller.totalListings %> Active Trade Listings
                        </span>
                        <span class="seller-stat-pill verified-pill">
                            ✦ Admiralty Guild Verified
                        </span>
                    </div>
                </div>
            </header>

            <!-- Merchant Lore & Bio Chronicle -->
            <section class="seller-bio-box">
                <h4>Merchant Log & Harbor Lore</h4>
                <p class="seller-bio-text">
                    <%= seller.bio || 'A seasoned merchant sailing the Archipelago trade winds, chartering authentic relics and provisions across the six islands under royal guild decree.' %>
                </p>
            </section>

            <!-- Storefront Status / Charter Verification Banner -->
            <aside class="seller-notice-banner storefront-charter-banner" role="note">
                <span class="notice-icon">📜</span>
                <div class="notice-content">
                    <strong>Archipelago Guild Storefront — Full Merchant Storefront Docking in Phase 3.4</strong>
                    <p>
                        Authorized trading post chartered by the Grand Admiralty Guild. All wares authenticated and backed by royal treasury Doubloons.
                    </p>
                </div>
            </aside>

            <!-- Complete Merchant Product Catalog (Milestone 3.4) -->
            <section class="seller-wares-section seller-catalog-section" aria-label="Merchant Product Catalog">
                <div class="seller-wares-header">
                    <div class="seller-wares-title-wrap">
                        <h2 class="seller-wares-title">Chartered Trade Catalog</h2>
                        <span class="seller-catalog-count-badge">
                            <%= products ? products.length : 0 %> <%= (products && products.length === 1) ? 'Ware' : 'Wares' %> Available
                        </span>
                    </div>
                    <span class="seller-wares-subtitle">
                        Authenticated relics and provisions offered by <%= seller.storeName || seller.name %>
                    </span>
                </div>

                <% if (products && products.length > 0) { %>
                    <!-- Active Catalog Grid -->
                    <div class="seller-wares-grid seller-catalog-grid" id="storeItemsGrid">
                        <% products.forEach(function(p) { %>
                            <div class="seller-sample-card store-item-card seller-store-card"
                                 data-id="<%= p.id %>"
                                 data-name="<%= p.name %>"
                                 data-price="<%= p.price %>"
                                 data-category="<%= p.category || 'relics' %>">

                                <!-- Visual Artifact Box -->
                                <a href="/product/<%= p.id %>" class="sample-card-link item-asset-link" title="Inspect <%= p.name %>">
                                    <div class="sample-asset-box">
                                        <img src="<%= p.image || '/images/items/default-relic.png' %>"
                                             alt="<%= p.name %>"
                                             class="sample-asset-img"
                                             onerror="this.onerror=null; this.src='/images/items/default-relic.png';">
                                    </div>
                                </a>

                                <!-- Provenance & Stock Badges -->
                                <div class="seller-card-provenance-row">
                                    <% if (p.island) { %>
                                        <span class="seller-origin-tag">🏝️ <%= p.island.replace('_', ' ') %></span>
                                    <% } %>
                                    <% if (p.stock > 5) { %>
                                        <span class="stock-badge in-vaults">⚓ In Vaults (<%= p.stock %>)</span>
                                    <% } else if (p.stock > 0) { %>
                                        <span class="stock-badge low-reserve">⚠️ Low Reserve (<%= p.stock %>)</span>
                                    <% } else { %>
                                        <span class="stock-badge barren">🚫 Barren</span>
                                    <% } %>
                                </div>

                                <!-- Title Link -->
                                <a href="/product/<%= p.id %>" class="item-title-link" title="Inspect <%= p.name %>">
                                    <h3 class="sample-card-title"><%= p.name %></h3>
                                </a>

                                <!-- Valuation & Star Rating -->
                                <div class="sample-card-meta">
                                    <span class="sample-card-price">🪙 <%= p.price %> Doubloons</span>
                                    <span class="sample-card-rating"><%= p.rating || '★★★★★' %></span>
                                </div>

                                <!-- Action Buttons: Details + Stow in Cargo -->
                                <div class="seller-card-actions">
                                    <a href="/product/<%= p.id %>" class="btn-sample-inspect btn-card-details" title="View Product Details">
                                        <span>🔍 VIEW DETAILS</span>
                                    </a>
                                    <button class="btn-add-cart btn-storefront-stow"
                                            data-id="<%= p.id %>"
                                            data-name="<%= p.name %>"
                                            data-price="<%= p.price %>"
                                            title="Stow in Cargo Hold">
                                        <span>🛒 STOW</span>
                                    </button>
                                </div>

                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <!-- Themed Sensible Empty Storefront State -->
                    <div class="seller-empty-state store-empty-state">
                        <div class="store-empty-icon">⚓</div>
                        <h3 class="store-empty-title">Harbor Vaults Currently Barren</h3>
                        <p class="store-empty-desc">
                            <%= seller.storeName || seller.name %> has no active trade wares charted in the archipelago at this tide. Check back after the next trade fleet docks.
                        </p>
                        <a href="/home" class="btn-seller-back btn-empty-nav">
                            <span>🧭 Return to Sea Chart</span>
                        </a>
                    </div>
                <% } %>
            </section>

            <!-- Primary Navigation Actions -->
            <footer class="seller-footer-actions">
                <a href="/home" class="btn-seller-back">
                    <span>⚓ Return to Sea Chart</span>
                </a>
                <% if (seller.homeIsland) { %>
                    <a href="/island/<%= seller.homeIsland %>" class="btn-seller-island">
                        <span>🏝️ Visit <%= island ? island.name : seller.homeIsland %></span>
                    </a>
                <% } %>
            </footer>

        </article>

    </main>

    <!-- Cargo Hold Drawer -->
    <aside id="storeCartDrawer" class="store-cart-drawer">
        <div class="cart-drawer-header">
            <h3 class="cart-drawer-title">⚓ Cargo Hold</h3>
            <button id="btnCloseCart" class="btn-cart-close">&times;</button>
        </div>
        <div id="cartDrawerItems" class="cart-drawer-items"></div>
        <div class="cart-drawer-footer">
            <div class="cart-total-row">
                <span>Total Cargo:</span>
                <span id="cartDrawerTotal">🪙 0 Doubloons</span>
            </div>
            <button id="btnCheckoutCargo" class="btn-checkout-cargo">
                Secure Cargo (Checkout)
            </button>
        </div>
    </aside>

    <!-- Unified Island Store JS Engine -->
    <script src="/js/island-store.js?v=seller_store_v1"></script>

</body>

</html>
