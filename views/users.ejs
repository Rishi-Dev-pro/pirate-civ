<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= page_title || "Chartered Merchants & Explorers | Pirate-Civ" %></title>


    <!-- Google Fonts -->

    <link
        href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet"
    >


    <!-- Users CSS -->

    <link
        rel="stylesheet"
        href="/css/users.css"
    >

</head>


<body>


    <!-- =====================================================
         BACKGROUND
    ====================================================== -->

    <div class="users-background">

        <div class="stars"></div>

        <div class="embers">

            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>

        </div>

    </div>



    <!-- =====================================================
         NAVBAR
    ====================================================== -->

    <%- include("partials/header") %>



    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="users-page">


        <!-- =================================================
             PAGE TITLE
        ================================================== -->

        <section class="users-heading">

            <div class="heading-symbol">
                ⚓
            </div>


            <div class="heading-line">

                <span></span>

                <p>
                    TERRA INCOGNITA
                </p>

                <span></span>

            </div>


            <h1>
                CHARTERED MERCHANTS
            </h1>


            <p class="heading-subtitle">
                Discover accredited merchant armators across the sovereign archipelago
            </p>


            <div class="heading-ornament">
                ✦
            </div>

        </section>



        <!-- =================================================
             PARCHMENT
        ================================================== -->

        <section class="parchment-wrapper">


            <div class="parchment">


                <!-- Parchment background -->

                <img
                    src="/images/users-parchment.png"
                    alt=""
                    class="parchment-image"
                >


                <!-- =================================================
                     CONTENT ON PARCHMENT
                ================================================== -->

                <div class="parchment-content">


                    <div class="parchment-title">

                        <span>✦</span>

                        <h2>
                            MERCHANT GUILD REGISTRY
                        </h2>

                        <span>✦</span>

                    </div>


                    <p class="parchment-description">
                        Accredited trade posts and cartographic armators authorized to forge and dispatch wares.
                    </p>



                    <!-- =================================================
                         USER LIST
                    ================================================== -->

                    <div class="users-list">


                        <% if (!users || users.length === 0) { %>

                            <div class="no-users">

                                <div class="no-users-icon">
                                    ⚓
                                </div>

                                <h3>
                                    No Chartered Merchants Yet
                                </h3>

                                <p>
                                    The trade ports are quiet. Stand by for arriving convoys.
                                </p>

                            </div>


                        <% } else { %>


                            <% users.forEach((merchant, index) => { %>


                                <article
                                    class="explorer-card"
                                    style="--delay: <%= index * 0.08 %>s;"
                                >


                                    <div class="explorer-number">

                                        <span>
                                            <%= String(index + 1).padStart(2, "0") %>
                                        </span>

                                    </div>


                                    <div class="explorer-icon">
                                        ⚓
                                    </div>


                                    <div class="explorer-info">


                                        <h3 style="font-family: 'Cinzel', serif; color: #ffd700; margin-bottom: 4px;">
                                            <%= merchant.storeName || merchant.name %>
                                        </h3>


                                        <% if (merchant.storeName && merchant.name && merchant.storeName !== merchant.name) { %>
                                            <p style="color: #cbb493; font-size: 13px; margin-bottom: 4px;">
                                                Guildmaster: <%= merchant.name %>
                                            </p>
                                        <% } %>

                                        <p style="color: #ffd57e; font-size: 12px; margin-bottom: 8px;">
                                            ⚓ Home Port: <%= (merchant.homeIsland || 'Archipelago').toUpperCase() %>
                                        </p>

                                        <% if (merchant.bio) { %>
                                            <p style="color: #a78860; font-size: 12px; line-height: 1.4; margin-bottom: 12px;">
                                                <%= merchant.bio %>
                                            </p>
                                        <% } %>

                                        <a href="/seller/<%= merchant._id %>" class="btn-discover-storefront" style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; background: rgba(212, 147, 57, 0.2); border: 1px solid rgba(212, 147, 57, 0.5); border-radius: 4px; color: #ffd700; font-family: 'Cinzel', serif; font-size: 11px; font-weight: 700; text-decoration: none; letter-spacing: 0.8px; transition: all 0.2s ease;">
                                            <span>📜 DISCOVER STOREFRONT &rarr;</span>
                                        </a>

                                    </div>


                                    <div class="explorer-mark">
                                        ✦
                                    </div>


                                </article>


                            <% }) %>


                        <% } %>


                    </div>


                </div>


            </div>


        </section>


    </main>


</body>

</html>