<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= page_title || "Chartered Merchants & Explorers | Pirate-Civ" %></title>


    <!-- Google Fonts -->

    <link
        href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet"
    >


    <!-- Users CSS -->

    <link
        rel="stylesheet"
        href="/css/users.css"
    >

</head>


<body>


    <!-- =====================================================
         BACKGROUND
    ====================================================== -->

    <div class="users-background">

        <div class="stars"></div>

        <div class="embers">

            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>

        </div>

    </div>



    <!-- =====================================================
         NAVBAR
    ====================================================== -->

    <%- include("partials/header") %>



    <!-- =====================================================
         MAIN
    ====================================================== -->

    <!-- =====================================================
         MAIN REGISTRY VIEWPORT
    ====================================================== -->

    <main class="users-page registry-page">

        <!-- =================================================
             PARCHMENT CHARTER MAP FRAME
        ================================================== -->

        <section class="registry-map-frame parchment-wrapper">

            <div class="parchment">

                <!-- Parchment texture map -->
                <img
                    src="/images/users-parchment.png"
                    alt="Merchant Guild Registry Parchment"
                    class="parchment-image"
                >

                <!-- =================================================
                     PARCHMENT ILLUMINATED CONTENT
                ================================================== -->

                <div class="parchment-content">

                    <!-- Fixed Registry Header -->
                    <header class="registry-header">

                        <h1 class="registry-title">
                            <span class="title-gem" aria-hidden="true">✦</span>
                            MERCHANT GUILD REGISTRY
                            <span class="title-gem" aria-hidden="true">✦</span>
                        </h1>

                        <p class="registry-subtitle">
                            Accredited trade posts and cartographic armators authorized to forge and dispatch wares.
                        </p>

                    </header>


                    <!-- =================================================
                         INTERNAL SCROLLABLE CHARTER REGISTRY
                    ================================================== -->

                    <div
                        class="registry-scroll-area users-list"
                        tabindex="0"
                        role="region"
                        aria-label="Merchant Guild Registry List"
                    >

                        <% if (!users || users.length === 0) { %>

                            <div class="no-users">

                                <div class="no-users-symbol" aria-hidden="true">
                                    ✦
                                </div>

                                <h3>
                                    No Chartered Merchants Yet
                                </h3>

                                <p>
                                    The trade ports are quiet. Stand by for arriving convoys.
                                </p>

                            </div>

                        <% } else { %>

                            <% users.forEach((merchant, index) => { %>

                                <article
                                    class="merchant-card explorer-card"
                                    style="--delay: <%= index * 0.05 %>s;"
                                >

                                    <div class="card-top">

                                        <!-- Merchant Crest / Avatar / Monogram -->
                                        <div class="merchant-crest" aria-hidden="true">
                                            <% if (merchant.avatar) { %>
                                                <img
                                                    src="<%= merchant.avatar %>"
                                                    alt=""
                                                    class="crest-avatar"
                                                >
                                            <% } else { %>
                                                <span class="crest-monogram">
                                                    <%= (merchant.storeName || merchant.name || 'M').charAt(0).toUpperCase() %>
                                                </span>
                                            <% } %>
                                        </div>

                                        <!-- Merchant Identity & Home Port -->
                                        <div class="merchant-meta">

                                            <h2 class="merchant-name">
                                                <%= merchant.storeName || merchant.name %>
                                            </h2>

                                            <% if (merchant.storeName && merchant.name && merchant.storeName.trim().toLowerCase() !== merchant.name.trim().toLowerCase()) { %>
                                                <p class="merchant-guildmaster">
                                                    <span class="meta-label">Guildmaster:</span>
                                                    <span class="guildmaster-name"><%= merchant.name %></span>
                                                </p>
                                            <% } %>

                                            <div class="merchant-port">
                                                <span class="port-label">HOME PORT</span>
                                                <span class="port-bullet" aria-hidden="true">·</span>
                                                <span class="port-name"><%= (merchant.homeIsland || 'Archipelago').replace(/_/g, ' ').toUpperCase() %></span>
                                            </div>

                                        </div>

                                    </div>

                                    <!-- Merchant Description / Bio if available -->
                                    <% if (merchant.bio) { %>
                                        <p class="merchant-bio">
                                            <%= merchant.bio %>
                                        </p>
                                    <% } %>

                                    <!-- Storefront Discovery Link -->
                                    <div class="card-bottom">

                                        <a
                                            href="/seller/<%= merchant._id %>"
                                            class="btn-discover-storefront"
                                            aria-label="Discover storefront for <%= merchant.storeName || merchant.name %>"
                                        >
                                            <span>DISCOVER STOREFRONT</span>
                                            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
                                        </a>

                                    </div>

                                </article>

                            <% }) %>

                        <% } %>

                    </div>

                    <!-- Subtle Parchment Bottom Seal -->
                    <footer class="registry-footer">
                        <span></span>
                        <div class="registry-footer-seal" aria-hidden="true">✦</div>
                        <span></span>
                    </footer>

                </div>

            </div>

        </section>

    </main>


</body>

</html>