<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= page_title || "Chartered Merchants & Explorers | Pirate-Civ" %></title>


    <!-- Google Fonts -->

    <link
        href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet"
    >


    <!-- Users CSS -->

    <link
        rel="stylesheet"
        href="/css/users.css"
    >

</head>


<body>


    <!-- =====================================================
         BACKGROUND
    ====================================================== -->

    <div class="users-background">

        <div class="stars"></div>

        <div class="embers">

            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>

        </div>

    </div>



    <!-- =====================================================
         NAVBAR
    ====================================================== -->

    <%- include("partials/header") %>



    <!-- =====================================================
         MAIN
    ====================================================== -->

    <!-- =====================================================
         MAIN REGISTRY VIEWPORT
    ====================================================== -->

    <main class="users-page registry-page">

        <!-- =================================================
             PARCHMENT CHARTER MAP FRAME
        ================================================== -->

        <section class="registry-map-frame parchment-wrapper">

            <div class="parchment">

                <!-- Parchment texture map -->
                <img
                    src="/images/users-parchment.png"
                    alt="Merchant Guild Registry Parchment"
                    class="parchment-image"
                >

                <!-- =================================================
                     PARCHMENT ILLUMINATED CONTENT
                ================================================== -->

                <div class="parchment-content">

                    <!-- Faint Cartographic Etchings Layer (Multiplied onto Parchment) -->
                    <div class="parchment-decor-layer" aria-hidden="true">

                        <!-- Upper Right Galleon Ship Etching -->
                        <svg class="map-decor-ship" viewBox="0 0 160 140">
                            <!-- Ocean swell waves -->
                            <path d="M 10 125 Q 35 120 60 126 Q 85 132 110 125 Q 135 118 155 126" stroke="#4A2E1A" stroke-width="1" fill="none" opacity="0.6" />
                            <path d="M 25 132 Q 50 128 75 133 Q 100 138 125 132 Q 145 127 155 131" stroke="#4A2E1A" stroke-width="0.7" fill="none" opacity="0.4" />
                            <!-- Hull -->
                            <path d="M 35 105 Q 30 112 40 122 Q 85 126 128 120 Q 140 108 135 105 Q 85 107 35 105 Z" fill="#6B4527" opacity="0.18" stroke="#4A2E1A" stroke-width="1.1" />
                            <!-- Sterncastle & Gun decks -->
                            <path d="M 35 105 L 36 94 L 54 96 L 54 105" fill="none" stroke="#4A2E1A" stroke-width="0.9" />
                            <path d="M 120 105 L 132 98 L 135 105" fill="none" stroke="#4A2E1A" stroke-width="0.9" />
                            <!-- Masts -->
                            <line x1="56" y1="45" x2="56" y2="105" stroke="#4A2E1A" stroke-width="1.3" />
                            <line x1="86" y1="26" x2="86" y2="105" stroke="#4A2E1A" stroke-width="1.6" />
                            <line x1="114" y1="48" x2="114" y2="105" stroke="#4A2E1A" stroke-width="1.3" />
                            <line x1="130" y1="102" x2="152" y2="82" stroke="#4A2E1A" stroke-width="1.1" />
                            <!-- Sails (Main mast) -->
                            <path d="M 72 74 Q 86 68 100 74 Q 97 92 86 92 Q 75 92 72 74 Z" fill="#8C5C35" opacity="0.15" stroke="#4A2E1A" stroke-width="0.9" />
                            <path d="M 74 46 Q 86 41 98 46 Q 96 64 86 64 Q 76 64 74 46 Z" fill="#8C5C35" opacity="0.15" stroke="#4A2E1A" stroke-width="0.9" />
                            <path d="M 77 28 Q 86 24 95 28 Q 94 40 86 40 Q 78 40 77 28 Z" fill="#8C5C35" opacity="0.15" stroke="#4A2E1A" stroke-width="0.8" />
                            <!-- Foremast sails -->
                            <path d="M 103 60 Q 114 56 125 60 Q 123 76 114 76 Q 105 76 103 60 Z" fill="#8C5C35" opacity="0.14" stroke="#4A2E1A" stroke-width="0.8" />
                            <path d="M 105 80 Q 114 77 123 80 Q 122 96 114 96 Q 106 96 105 80 Z" fill="#8C5C35" opacity="0.14" stroke="#4A2E1A" stroke-width="0.8" />
                            <!-- Mizzen mast sails -->
                            <path d="M 46 62 Q 56 58 66 62 Q 64 78 56 78 Q 48 78 46 62 Z" fill="#8C5C35" opacity="0.14" stroke="#4A2E1A" stroke-width="0.8" />
                            <path d="M 47 82 Q 56 79 65 82 Q 64 97 56 97 Q 48 97 47 82 Z" fill="#8C5C35" opacity="0.14" stroke="#4A2E1A" stroke-width="0.8" />
                            <!-- Rigging lines & flags -->
                            <line x1="86" y1="26" x2="38" y2="105" stroke="#4A2E1A" stroke-width="0.6" opacity="0.7" />
                            <line x1="86" y1="26" x2="135" y2="105" stroke="#4A2E1A" stroke-width="0.6" opacity="0.7" />
                            <line x1="56" y1="45" x2="38" y2="105" stroke="#4A2E1A" stroke-width="0.5" opacity="0.6" />
                            <line x1="114" y1="48" x2="148" y2="86" stroke="#4A2E1A" stroke-width="0.5" opacity="0.6" />
                            <polygon points="86,26 96,29 86,32" fill="#5A3820" opacity="0.75" />
                        </svg>

                        <!-- Middle Right Island & Mountain Coastline Etching -->
                        <svg class="map-decor-island-1" viewBox="0 0 170 90">
                            <!-- Mountain ridgelines -->
                            <path d="M 15 75 Q 35 48 55 52 Q 75 28 95 44 Q 115 22 135 42 Q 150 55 165 72" fill="#6B4527" opacity="0.12" stroke="#4A2E1A" stroke-width="1" />
                            <path d="M 75 28 L 78 55 M 95 44 L 98 62 M 115 22 L 118 58 M 135 42 L 137 66" stroke="#4A2E1A" stroke-width="0.6" opacity="0.5" />
                            <!-- Coastal hachures & water ripples -->
                            <path d="M 5 78 Q 45 74 85 78 Q 125 82 168 76" stroke="#4A2E1A" stroke-width="0.9" fill="none" opacity="0.6" />
                            <path d="M 18 82 Q 55 80 95 83 Q 135 85 162 81" stroke="#4A2E1A" stroke-width="0.6" fill="none" opacity="0.4" />
                            <path d="M 32 86 Q 70 85 105 87 Q 140 88 158 85" stroke="#4A2E1A" stroke-width="0.5" fill="none" opacity="0.3" />
                        </svg>

                        <!-- Lower Right Watchtower & Palm Island Etching -->
                        <svg class="map-decor-island-2" viewBox="0 0 160 100">
                            <!-- Island hill contour -->
                            <path d="M 10 82 Q 40 68 70 72 Q 95 52 115 54 Q 135 68 155 84" fill="#6B4527" opacity="0.12" stroke="#4A2E1A" stroke-width="1" />
                            <!-- Castle Watchtower -->
                            <rect x="98" y="38" width="16" height="24" fill="#7A4C1C" opacity="0.15" stroke="#4A2E1A" stroke-width="0.9" />
                            <!-- Battlements & Turret window -->
                            <path d="M 96 38 L 96 34 L 100 34 L 100 36 L 104 36 L 104 34 L 108 34 L 108 36 L 112 36 L 112 34 L 116 34 L 116 38 Z" fill="#4A2E1A" opacity="0.7" />
                            <line x1="106" y1="44" x2="106" y2="49" stroke="#4A2E1A" stroke-width="1.2" />
                            <!-- Palm trees -->
                            <path d="M 132 80 Q 138 66 142 56" stroke="#4A2E1A" stroke-width="1.2" fill="none" />
                            <path d="M 142 56 Q 136 50 128 54 M 142 56 Q 140 48 135 46 M 142 56 Q 146 47 152 48 M 142 56 Q 150 52 154 58 M 142 56 Q 144 64 140 68" stroke="#4A2E1A" stroke-width="0.9" fill="none" />
                            <!-- Shore waves -->
                            <path d="M 5 88 Q 45 84 90 87 Q 130 90 158 86" stroke="#4A2E1A" stroke-width="0.8" fill="none" opacity="0.5" />
                        </svg>

                        <!-- Left Margin Compass Rose Markings -->
                        <svg class="map-decor-compass-left" viewBox="0 0 100 100">
                            <circle cx="50" cy="50" r="45" fill="none" stroke="#4A2E1A" stroke-width="0.7" stroke-dasharray="2, 3" opacity="0.4" />
                            <circle cx="50" cy="50" r="36" fill="none" stroke="#4A2E1A" stroke-width="0.5" opacity="0.3" />
                            <line x1="50" y1="0" x2="50" y2="100" stroke="#4A2E1A" stroke-width="0.6" stroke-dasharray="2, 2" opacity="0.3" />
                            <line x1="0" y1="50" x2="100" y2="50" stroke="#4A2E1A" stroke-width="0.6" stroke-dasharray="2, 2" opacity="0.3" />
                        </svg>

                    </div>

                    <!-- Fixed Registry Header Inside Parchment -->
                    <header class="registry-header">

                        <!-- Top Engraved Compass Rose -->
                        <div class="registry-compass-rose" aria-hidden="true">
                            <svg viewBox="0 0 100 100" class="header-compass-svg">
                                <circle cx="50" cy="50" r="46" fill="none" stroke="#7A4C1C" stroke-width="0.8" stroke-dasharray="1.5, 2.5" opacity="0.65" />
                                <circle cx="50" cy="50" r="42" fill="none" stroke="#7A4C1C" stroke-width="1.2" opacity="0.8" />
                                <circle cx="50" cy="50" r="32" fill="none" stroke="#7A4C1C" stroke-width="0.6" stroke-dasharray="1, 2" opacity="0.6" />
                                <circle cx="50" cy="50" r="16" fill="none" stroke="#7A4C1C" stroke-width="1" opacity="0.75" />
                                <!-- 8 directional points -->
                                <polygon points="50,6 50,50 46,50" fill="#3D2210" />
                                <polygon points="50,6 50,50 54,50" fill="#996627" />
                                <polygon points="50,94 50,50 54,50" fill="#3D2210" />
                                <polygon points="50,94 50,50 46,50" fill="#996627" />
                                <polygon points="94,50 50,50 50,46" fill="#3D2210" />
                                <polygon points="94,50 50,50 50,54" fill="#996627" />
                                <polygon points="6,50 50,50 50,54" fill="#3D2210" />
                                <polygon points="6,50 50,50 50,46" fill="#996627" />
                                <!-- Corner points -->
                                <polygon points="81,19 50,50 50,46" fill="#5A3519" opacity="0.9" />
                                <polygon points="81,19 50,50 54,50" fill="#B38038" opacity="0.9" />
                                <polygon points="19,19 50,50 46,50" fill="#5A3519" opacity="0.9" />
                                <polygon points="19,19 50,50 50,46" fill="#B38038" opacity="0.9" />
                                <polygon points="81,81 50,50 54,50" fill="#5A3519" opacity="0.9" />
                                <polygon points="81,81 50,50 50,54" fill="#B38038" opacity="0.9" />
                                <polygon points="19,81 50,50 50,54" fill="#5A3519" opacity="0.9" />
                                <polygon points="19,81 50,50 46,50" fill="#B38038" opacity="0.9" />
                                <circle cx="50" cy="50" r="4.5" fill="#C89B4E" stroke="#3D2210" stroke-width="0.9" />
                                <circle cx="50" cy="50" r="1.8" fill="#3D2210" />
                            </svg>
                        </div>

                        <!-- Registry Title -->
                        <h1 class="registry-title">
                            <span class="title-primary">MERCHANT GUILD</span>
                            <span class="title-secondary">REGISTRY</span>
                        </h1>

                        <p class="registry-subtitle">
                            Accredited trade posts and cartographic armators authorized to forge and dispatch wares.
                        </p>

                        <!-- Subtle Document Section Divider with Nautical Star -->
                        <div class="registry-divider" aria-hidden="true">
                            <span></span>
                            <span class="divider-star">✦</span>
                            <span></span>
                        </div>

                    </header>


                    <!-- =================================================
                         INTERNAL SCROLLABLE CHARTER REGISTRY
                    ================================================== -->

                    <div
                        class="registry-scroll-area users-list"
                        tabindex="0"
                        role="region"
                        aria-label="Merchant Guild Registry List"
                    >

                        <% if (!users || users.length === 0) { %>

                            <div class="no-users">

                                <div class="no-users-symbol" aria-hidden="true">
                                    ✦
                                </div>

                                <h3>
                                    No Chartered Merchants Yet
                                </h3>

                                <p>
                                    The trade ports are quiet. Stand by for arriving convoys.
                                </p>

                            </div>

                        <% } else { %>

                            <% users.forEach((merchant, index) => { %>

                                <article
                                    class="merchant-entry merchant-card explorer-card"
                                    style="--delay: <%= index * 0.05 %>s;"
                                    data-merchant-id="<%= merchant._id %>"
                                >

                                    <div class="entry-layout">

                                        <!-- Heraldic Guild Seal with Radiating Astrolabe Needle Ring -->
                                        <div class="seal-container" aria-hidden="true">

                                            <!-- Radiating Astrolabe Needle / Tick Mark Ring -->
                                            <svg viewBox="0 0 80 80" class="seal-astrolabe-svg">
                                                <circle cx="40" cy="40" r="37" fill="none" stroke="#7A4C1C" stroke-width="0.8" opacity="0.5" />
                                                <circle cx="40" cy="40" r="33.5" fill="none" stroke="#7A4C1C" stroke-width="0.5" stroke-dasharray="1.2, 3" opacity="0.6" />
                                                <g stroke="#7A4C1C" stroke-width="1" opacity="0.65">
                                                    <line x1="40" y1="0.5" x2="40" y2="4.5" />
                                                    <line x1="40" y1="75.5" x2="40" y2="79.5" />
                                                    <line x1="0.5" y1="40" x2="4.5" y2="40" />
                                                    <line x1="75.5" y1="40" x2="79.5" y2="40" />
                                                    <line x1="12" y1="12" x2="15" y2="15" />
                                                    <line x1="65" y1="65" x2="68" y2="68" />
                                                    <line x1="12" y1="68" x2="15" y2="65" />
                                                    <line x1="65" y1="15" x2="68" y2="12" />
                                                    <line x1="25.5" y1="4.5" x2="27" y2="8.5" />
                                                    <line x1="54.5" y1="4.5" x2="53" y2="8.5" />
                                                    <line x1="25.5" y1="75.5" x2="27" y2="71.5" />
                                                    <line x1="54.5" y1="75.5" x2="53" y2="71.5" />
                                                    <line x1="4.5" y1="25.5" x2="8.5" y2="27" />
                                                    <line x1="4.5" y1="54.5" x2="8.5" y2="53" />
                                                    <line x1="75.5" y1="25.5" x2="71.5" y2="27" />
                                                    <line x1="75.5" y1="54.5" x2="71.5" y2="53" />
                                                </g>
                                            </svg>

                                            <!-- Stamped Enameled Guild Seal -->
                                            <div class="merchant-crest seal-<%= (index % 3 === 0) ? 'navy' : (index % 3 === 1) ? 'burgundy' : 'teal' %>">

                                                <% if (merchant.avatar) { %>
                                                    <img
                                                        src="<%= merchant.avatar %>"
                                                        alt=""
                                                        class="crest-avatar"
                                                    >
                                                <% } else if (index % 3 === 0) { %>
                                                    <!-- Galleon Sailing Ship Emblem (Astrolabe / Port Master) -->
                                                    <svg viewBox="0 0 44 44" class="crest-emblem-svg">
                                                        <path d="M 6 34 Q 10 32 14 34 Q 18 36 22 34 Q 26 32 30 34 Q 34 36 38 34" fill="none" stroke="#D3AD68" stroke-width="1.2" stroke-linecap="round" opacity="0.85" />
                                                        <path d="M 8 36.5 Q 12 35 16 36.5 Q 20 38 24 36.5 Q 28 35 32 36.5 Q 36 38 38 36.5" fill="none" stroke="#D3AD68" stroke-width="0.8" opacity="0.55" />
                                                        <path d="M 10 27 Q 9 29 12 32 Q 22 33.5 32 32 Q 35 29 34 27 Z" fill="#E8C882" stroke="#8C5824" stroke-width="0.8" />
                                                        <path d="M 10 27 L 10 24 L 14 25 L 14 27 Z" fill="#E8C882" stroke="#8C5824" stroke-width="0.6" />
                                                        <path d="M 30 27 L 34 25 L 34 27 Z" fill="#E8C882" stroke="#8C5824" stroke-width="0.6" />
                                                        <line x1="15" y1="12" x2="15" y2="27" stroke="#E8C882" stroke-width="1.2" />
                                                        <line x1="22" y1="8" x2="22" y2="27" stroke="#E8C882" stroke-width="1.4" />
                                                        <line x1="29" y1="13" x2="29" y2="27" stroke="#E8C882" stroke-width="1.2" />
                                                        <line x1="33" y1="26" x2="38" y2="21" stroke="#E8C882" stroke-width="1" />
                                                        <path d="M 18 19 Q 22 17 26 19 Q 25 24 22 24 Q 19 24 18 19 Z" fill="#F3DC9B" stroke="#8C5824" stroke-width="0.6" />
                                                        <path d="M 19 12 Q 22 10 25 12 Q 24.5 16 22 16 Q 19.5 16 19 12 Z" fill="#F3DC9B" stroke="#8C5824" stroke-width="0.6" />
                                                        <path d="M 27 15 Q 29 14 31 15 Q 30.5 19 29 19 Q 27.5 19 27 15 Z" fill="#F3DC9B" stroke="#8C5824" stroke-width="0.6" />
                                                        <path d="M 27 21 Q 29 20 31 21 Q 30.5 25 29 25 Q 27.5 25 27 21 Z" fill="#F3DC9B" stroke="#8C5824" stroke-width="0.6" />
                                                        <path d="M 13 15 Q 15 14 17 15 Q 16.5 19 15 19 Q 13.5 19 13 15 Z" fill="#F3DC9B" stroke="#8C5824" stroke-width="0.6" />
                                                        <path d="M 13 21 Q 15 20 17 21 Q 16.5 25 15 25 Q 13.5 25 13 21 Z" fill="#F3DC9B" stroke="#8C5824" stroke-width="0.6" />
                                                        <polygon points="22,8 26,9.5 22,11" fill="#D3AD68" />
                                                    </svg>
                                                <% } else if (index % 3 === 1) { %>
                                                    <!-- Crossed Cutlasses Emblem (Cutlass Cove / Armourer) -->
                                                    <svg viewBox="0 0 44 44" class="crest-emblem-svg">
                                                        <path d="M 10 10 Q 20 18 31 31 L 33 29 Q 22 16 12 8 Z" fill="#F3DC9B" stroke="#8C5824" stroke-width="0.6" />
                                                        <path d="M 10 10 L 9 8 Q 12 8 13 10 Z" fill="#D3AD68" />
                                                        <path d="M 30 28 Q 36 30 33 36 Q 28 35 29 31 Z" fill="none" stroke="#D3AD68" stroke-width="1.4" />
                                                        <line x1="31" y1="31" x2="35" y2="35" stroke="#C89B4E" stroke-width="2.2" stroke-linecap="round" />
                                                        <circle cx="36" cy="36" r="1.8" fill="#E8C882" stroke="#5A3820" stroke-width="0.6" />
                                                        <path d="M 34 10 Q 24 18 13 31 L 11 29 Q 22 16 32 8 Z" fill="#F3DC9B" stroke="#8C5824" stroke-width="0.6" />
                                                        <path d="M 34 10 L 35 8 Q 32 8 31 10 Z" fill="#D3AD68" />
                                                        <path d="M 14 28 Q 8 30 11 36 Q 16 35 15 31 Z" fill="none" stroke="#D3AD68" stroke-width="1.4" />
                                                        <line x1="13" y1="31" x2="9" y2="35" stroke="#C89B4E" stroke-width="2.2" stroke-linecap="round" />
                                                        <circle cx="8" cy="36" r="1.8" fill="#E8C882" stroke="#5A3820" stroke-width="0.6" />
                                                        <circle cx="22" cy="22" r="3" fill="#C89B4E" stroke="#3D2210" stroke-width="0.8" />
                                                    </svg>
                                                <% } else { %>
                                                    <!-- Sea Trident Emblem (Kraken / Deep-sea Haven) -->
                                                    <svg viewBox="0 0 44 44" class="crest-emblem-svg">
                                                        <path d="M 22 7 L 24.5 14 L 23 16 L 23 37 L 21 37 L 21 16 L 19.5 14 Z" fill="#F3DC9B" stroke="#8C5824" stroke-width="0.7" />
                                                        <line x1="22" y1="8" x2="22" y2="15" stroke="#8C5824" stroke-width="0.8" />
                                                        <path d="M 12 11 Q 12 21 21 21 L 21 19 Q 14.5 19 14 13 L 15.5 13.5 L 12 11 Z" fill="#F3DC9B" stroke="#8C5824" stroke-width="0.7" />
                                                        <path d="M 32 11 Q 32 21 23 21 L 23 19 Q 29.5 19 30 13 L 28.5 13.5 L 32 11 Z" fill="#F3DC9B" stroke="#8C5824" stroke-width="0.7" />
                                                        <rect x="17" y="20.5" width="10" height="2.5" rx="1" fill="#D3AD68" stroke="#5A3820" stroke-width="0.6" />
                                                        <line x1="20" y1="26" x2="24" y2="26" stroke="#D3AD68" stroke-width="1.2" />
                                                        <line x1="20" y1="31" x2="24" y2="31" stroke="#D3AD68" stroke-width="1.2" />
                                                        <polygon points="20.5,37 23.5,37 22,40" fill="#D3AD68" stroke="#5A3820" stroke-width="0.6" />
                                                    </svg>
                                                <% } %>

                                            </div>

                                        </div>

                                        <!-- Merchant Identity, Port & Bio Column -->
                                        <div class="entry-content">

                                            <div class="merchant-meta">

                                                <h2 class="merchant-name">
                                                    <%= merchant.storeName || merchant.name %>
                                                </h2>

                                                <% if (merchant.storeName && merchant.name && merchant.storeName.trim().toLowerCase() !== merchant.name.trim().toLowerCase()) { %>
                                                    <p class="merchant-guildmaster">
                                                        <span class="meta-label">Guildmaster</span>
                                                        <span class="meta-bullet" aria-hidden="true">·</span>
                                                        <span class="guildmaster-name"><%= merchant.name %></span>
                                                    </p>
                                                <% } %>

                                                <div class="merchant-port">
                                                    <span class="port-label">HOME PORT</span>
                                                    <span class="port-name"><%= (merchant.homeIsland || 'Archipelago').replace(/_/g, ' ').toUpperCase() %></span>
                                                </div>

                                            </div>

                                            <!-- Merchant Description / Bio -->
                                            <% if (merchant.bio) { %>
                                                <p class="merchant-bio">
                                                    <%= merchant.bio %>
                                                </p>
                                            <% } %>

                                            <!-- Storefront Discovery Link -->
                                            <div class="card-bottom entry-action">

                                                <a
                                                    href="/seller/<%= merchant._id %>"
                                                    class="btn-discover-storefront"
                                                    aria-label="Discover storefront for <%= merchant.storeName || merchant.name %>"
                                                >
                                                    <span>DISCOVER STOREFRONT</span>
                                                    <span class="btn-arrow" aria-hidden="true">&rarr;</span>
                                                </a>

                                            </div>

                                        </div>

                                    </div>

                                    <!-- Thin Document Divider Between Merchants -->
                                    <div class="entry-divider" aria-hidden="true">
                                        <span></span>
                                        <span class="divider-star">✦</span>
                                        <span></span>
                                    </div>

                                </article>

                            <% }) %>

                        <% } %>

                    </div>

                    <!-- Subtle Parchment Bottom Seal -->
                    <footer class="registry-footer">
                        <span></span>
                        <div class="registry-footer-seal" aria-hidden="true">✦</div>
                        <span></span>
                    </footer>

                </div>

            </div>

        </section>

    </main>


</body>

</html>